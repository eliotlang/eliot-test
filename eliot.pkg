-- The Eliot test framework as a package. One anonymous module: `src/` is the framework, `test/` is
-- its own suite, and both sit at the repository root, which is what no `module` clause means.
--
-- Both layers of the base are named, because `src` resolves against what it declares and nothing
-- else: the assertions and the mocks are written over `eliot.collection.List`, `eliot.file` and
-- `eliot.system`, and the runner reaches every suite in a program through `eliot.compiler.Reflect`,
-- which the `lang` layer declares rather than `stdlib`.
--
-- The platform layer is a test-scope dependency, not a base one: a framework is as
-- platform-independent as what it tests, and it is only *running* the suite that needs a jvm.
--
-- The `runner` artifact is the executable this repository ships: `eliot.test.Runner` is a `main` that
-- reflects over every `testCases` in a program, so a suite is built by pointing this configuration at a
-- project rather than by anything this package does on its own. It names `//jvm` because a platform
-- layer is declared per artifact, and it needs no `backend <package>` — `//jvm` is the one plugin in
-- its closure that registers a command word.
--
-- `v0.1` is the floor because that is where the layers' `plugin` clauses start: a tag that declares no
-- plugin ships no compiler a consumer can find, so `eliot build` against `v0.0` correctly refuses.
-- Nothing here needs anything newer than `v0.1`'s sources.

dep github.com/robertbraeutigam/eliot//lang v0.1
dep github.com/robertbraeutigam/eliot//stdlib v0.1

artifact runner {
  dep github.com/robertbraeutigam/eliot//jvm v0.1
  backend {
    kind exe-jar
    main eliot.test.Runner
  }
}

test {
  dep github.com/robertbraeutigam/eliot//jvm v0.1
}
