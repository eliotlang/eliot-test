import eliot.carrier.Effect
import eliot.collection.List
import eliot.file.Path
import eliot.file.File
import eliot.system.Process
import eliot.system.Environment
import eliot.test.Assertion

/**
 * Mocking, as a test writes it: one word to enter a mocked case, words to *arrange* what the doubles answer,
 * and words to *verify* what the code under test asked them.
 *
 * ```eliot
 * "publishedTags" should "clone a mirror it has not seen, then read what it published" in mocked {
 *    whenSpawning("ls-remote", succeeding(listing))          -- arrange
 *
 *    val published = publishedTags(cacheRoot, cached)        -- act
 *
 *    published.size shouldBe 2                               -- assert on the answer
 *    wasCalled("git clone --mirror")                         -- ...and on the interaction
 * }
 * ```
 *
 * **A mocked case names no carrier and writes no fixture.** Production code that declares
 * `{Process, FileSystem}` names no carrier either, so instantiating it here is what makes its effects this
 * framework's doubles; `eliot.test.Mock` holds those doubles and is not something a test imports.
 *
 * **Arranging is an effect**, which is why `mocked` takes only a block: `whenSpawning(…)` performed inside the
 * body is what tells the double, so there is no world to build outside and hand in. A shared arrangement is an
 * ordinary definition — `private def mirrored: {Mocking} Unit = withDirectory(path("target/cache"))`, called at
 * the top of a body — which is this framework's `@Before`, with no annotation behind it. **The most recent
 * arrangement wins**, so a body may act, re-arm a double, and act again.
 *
 * **Matching is by containment.** Every verification and `whenSpawning` takes a *fragment*: a call matches when
 * the recorded line contains it, so `wasCalled("ls-remote")` says what it means without spelling a whole
 * command line, and `wasCalled("git ls-remote --tags github.com/x/foo")` is available when the whole line is
 * the point. `calls` answers the recorded lines themselves when a test wants to assert on them directly.
 *
 * **What a mocked case cannot do is reach the outside**: the mock carrier has no `Suspend` instance, and
 * `Suspend` is the only route to a native side effect, so an effect nothing mocks is a compile error rather
 * than a test that quietly performs I/O.
 */


/**
 * Run `body` as a mocked case — the counterpart of `pure`, standing in exactly the same place:
 * `"…" should "…" in mocked { … }`.
 *
 * The body may perform any effect this framework doubles, arrange what those doubles answer, verify what they
 * were asked, and assert on values, in any order. It starts from nothing arranged and nothing called. A raise
 * that is not expected — the code under test failing, or an assertion failing — ends the body and fails the
 * case with what was raised.
 */
def mocked(body: {| Mock} Unit): {Throw[AssertionError]} Unit =
   orRaise(first(mockOutcome(emptyRecording, body)).foldEither(report -> Left(Failed(report)), _ -> Right(unit)))

/**
 * Arrange what a spawned process answers: any command line **containing** `commandFragment` answers `result`.
 *
 * ```eliot
 * whenSpawning("ls-remote", succeeding(listing))
 * whenSpawning("clone --mirror", failing(128, "no such repository"))
 * ```
 */
def whenSpawning(commandFragment: String, result: ProcessResult): {Mocking} Unit =
   arranged(Spawning(commandFragment, result))

/**
 * A process that succeeded, saying `output` — `ProcessResult(0, output, "")`, spelled as what it means.
 */
def succeeding(output: String): ProcessResult = ProcessResult(0, output, "")

/**
 * A process that ran and said no: a non-zero `exitCode` and `diagnostics` on standard error. Not a failure of
 * the `Process` effect — a non-zero exit is data, and reading it is the caller's business.
 */
def failing(exitCode: Int, diagnostics: String): ProcessResult = ProcessResult(exitCode, "", diagnostics)

/**
 * A process that exited with `exitCode`, having written `output` — for the case that is neither plain success
 * nor plain failure.
 */
def exiting(exitCode: Int, output: String): ProcessResult = ProcessResult(exitCode, output, "")

/**
 * Arrange a spawned process that *changes the world*: any command line containing `commandFragment` also makes
 * `created` exist, the way `git clone` or `unzip` leaves a directory behind.
 *
 * The `thenAnswer` of this framework, kept to the one side effect a spawned program has that later code looks
 * at. It composes with `whenSpawning`, which decides what the same command *says*: arrange both for a command
 * that does both.
 *
 * ```eliot
 * whenSpawning("clone --mirror", succeeding(""))
 * whenSpawningCreates("clone --mirror", path("target/cache/github.com/x/foo"))
 * ```
 *
 * This is what lets a test *observe* "clone on the first visit, not on the second" within one run, instead of
 * seeding the directory and taking the second half on trust.
 */
def whenSpawningCreates(commandFragment: String, created: Path): {Mocking} Unit =
   arranged(Creating(commandFragment, show(created)))

/**
 * Arrange the console input: `readLine` hands out `lines` in order, then answers `None` — end of input.
 *
 * Replaces whatever input was queued before rather than adding to it, so a body can re-arm mid-test.
 */
def whenReading(lines: List[String]): {Mocking} Unit = queued(lines)

/**
 * Arrange a file: reading `at` answers `content`, and it exists.
 */
def withFile(at: Path, content: String): {Mocking} Unit = arranged(Holding(show(at), content))

/**
 * Arrange a directory: it exists, and `isDirectory` says so.
 */
def withDirectory(at: Path): {Mocking} Unit = arranged(Existing(show(at)))

/**
 * Arrange an environment variable.
 */
def withVariable(name: String, value: String): {Mocking} Unit = arranged(Defining(name, value))

/**
 * Arrange the program's arguments, as `Environment.arguments` will answer them.
 */
def withArguments(passed: List[String]): {Mocking} Unit = arranged(Passing(passed))

/**
 * Arrange the directory the program believes it is running in.
 */
def withWorkingDirectory(at: Path): {Mocking} Unit = arranged(WorkingIn(show(at)))

/**
 * Every call the doubles have been asked, in order, as one line apiece joined by `"; "` — for a test that
 * wants to assert on the whole interaction rather than call by call.
 *
 * ```eliot
 * calls shouldBe "printLine hello; readLine"
 * ```
 *
 * Text rather than a list because the standard library has no `Eq`/`Show` for `List`, so a list could not be
 * compared by an assertion; `callCount` and the `wasCalled…` words are how a test asks about one call.
 */
def calls: {Calls} String = recordedCalls.joined("; ")

/**
 * The recorded calls containing `fragment`, joined the same way — the argument captor of this framework: what
 * was actually asked, for a test that wants to assert on the arguments and not only on the fact of the call.
 *
 * ```eliot
 * callsMatching("git clone") shouldBe ".$ git clone --mirror https://github.com/x/foo target/cache"
 * ```
 */
def callsMatching(fragment: String): {Calls} String = matchingCalls(fragment).joined("; ")

/**
 * The most recent call, or `"<none>"` where nothing has been asked yet.
 */
def lastCall: {Calls} String = recordedCalls.last orElse "<none>"

/**
 * How many calls contained `fragment`.
 */
def callCount(fragment: String): {Calls} Int = matchingCalls(fragment).size

/**
 * Forget every call recorded so far, keeping the arrangements — the `reset` of this framework, for a body that
 * has finished with one phase of a scenario and wants to verify the next one on its own.
 */
def forgetCalls: {Mocking} Unit = forgotten

/**
 * Verify that some call contained `fragment`.
 */
def wasCalled(fragment: String): {Calls, Throw[AssertionError]} Unit =
   fold(callCount(fragment) > 0, success, missing("a call containing '" ++ fragment ++ "'"))

/**
 * Verify that no call contained `fragment` — that the code under test did *not* do something.
 */
def wasNeverCalled(fragment: String): {Calls, Throw[AssertionError]} Unit =
   fold(
      callCount(fragment) == 0,
      success,
      raise(Failed("expected no call containing '" ++ fragment ++ "', but found " ++ callsMatching(fragment)))
   )

/**
 * Verify that exactly one call contained `fragment` — the common case of `wasCalledTimes`, and the one worth
 * its own word: "it cloned the mirror, and only once".
 */
def wasCalledOnce(fragment: String): {Calls, Throw[AssertionError]} Unit = wasCalledTimes(1, fragment)

/**
 * Verify that exactly `count` calls contained `fragment`.
 */
def wasCalledTimes(count: Int, fragment: String): {Calls, Throw[AssertionError]} Unit =
   fold(callCount(fragment) == count, success, countMismatch(count, fragment, "exactly"))

/**
 * Verify that at least `count` calls contained `fragment`.
 */
def wasCalledAtLeast(count: Int, fragment: String): {Calls, Throw[AssertionError]} Unit =
   fold(callCount(fragment) >= count, success, countMismatch(count, fragment, "at least"))

/**
 * Verify that at most `count` calls contained `fragment`.
 */
def wasCalledAtMost(count: Int, fragment: String): {Calls, Throw[AssertionError]} Unit =
   fold(callCount(fragment) <= count, success, countMismatch(count, fragment, "at most"))

/**
 * Verify that calls containing each of `fragments` happened, in that order — other calls in between are
 * allowed, exactly as an `InOrder` verification permits.
 */
def wereCalledInOrder(fragments: List[String]): {Calls, Throw[AssertionError]} Unit =
   fold(
      recordedCalls.foldLeft(fragments, call -> pending -> advanced(call, pending)).isEmpty,
      success,
      raise(Failed("expected calls in order: " ++ fragments.joined(", ") ++ "; got: " ++ describedCalls))
   )

/**
 * Verify that nothing was asked of any double at all.
 */
def nothingWasCalled: {Calls, Throw[AssertionError]} Unit =
   fold(recordedCalls.isEmpty, success, raise(Failed("expected no calls, but found " ++ calls)))

/**
 * Verify that every call made matched one of `fragments` — that the code under test did what was expected of
 * it *and nothing else*. The `verifyNoMoreInteractions` of this framework, and the one verification that can
 * catch a call nobody thought to check for.
 */
def onlyTheseWereCalled(fragments: List[String]): {Calls, Throw[AssertionError]} Unit =
   fold(
      unexpectedCalls(fragments).isEmpty,
      success,
      raise(Failed("unexpected calls: " ++ unexpectedCalls(fragments).joined("; ")))
   )

/**
 * The mock carrier and its instances: the machinery that lets a test run production code against test
 * doubles of the effects it performs, with no fixture of its own.
 *
 * **Nothing here is what a test writes.** A test imports `eliot.test.Mocked`, which is the vocabulary —
 * `mocked { … }`, the `when…`/`with…` arranging words, and the verifications. This module is the machinery
 * those words are made of, kept separate so the vocabulary a test imports carries no `eliot.file.File` names
 * with it.
 *
 * **Why the framework owns this and a project cannot.** An instance must live with its ability or with one
 * of its type arguments, and an ability may have at most one carrier-generic instance — so mock instances
 * are necessarily concrete (`implement Console[Mock]`), and necessarily colocated with the mock carrier.
 * Whoever declares the carrier must therefore write every mock, which is why each project used to rewrite
 * two hundred lines of fixture, and why this file exists once instead. See `docs/mocking.md` §2.
 *
 * **How the doubles are chosen.** Nothing is registered: the platform's own instances are
 * `implement[F[_] ~ Suspend & …]`, `Mock` has no `Suspend`, so those decline and these are the unique
 * survivors. It is also why a mocked test *cannot* reach a real process or a real file: `Suspend` is the
 * only route to a native side effect, so an unmocked one is a compile error rather than a test that
 * quietly does I/O.
 *
 * **What a mock answers** is decided by the `Arrangement`s a body has made when the call happens, most
 * recent first, so a mock can be re-armed mid-test. Anything unarranged answers the honest "nothing there"
 * for its method — no such file, no input, an exit code of zero — and every call, arranged or not, is
 * recorded in the journal, which is what the verifications read.
 */


/**
 * One thing a test has told a mock, most recent taking precedence.
 *
 * A single list rather than a field per effect: the mocks are all in this file, so each reads the shapes it
 * cares about, and a new mocked effect adds a constructor rather than a field to every builder.
 */
data Arrangement =
   Spawning(commandFragment: String, spawnedResult: ProcessResult) |
   Holding(filePath: String, fileContent: String) |
   Existing(existingPath: String) |
   Creating(creatingFragment: String, createdPath: String) |
   Defining(variableName: String, variableValue: String) |
   Passing(passedArguments: List[String]) |
   WorkingIn(workingPath: String)

/**
 * What the mocks have been told and what they have been asked: the arrangements a body has made, the calls
 * it has caused in order, and the console input still to be handed out.
 */
data Recording(journal: List[String], arrangements: List[Arrangement], pendingInput: List[String])

/**
 * The mock carrier: a recording in, a value or a failure out, and the recording after.
 *
 * The failure is **rendered text** rather than a typed error, and that is forced rather than chosen: one
 * generic `Throw[E, Mock]` is what lets a project's own error types raise here without an instance they
 * could not legally write, and a second, more specific instance beside it is rejected ("Overlapping ability
 * implementation"). So every raise — a production error, or an assertion inside a mocked body — arrives
 * here already rendered by its own `Show`, and `eliot.test.Mocked` turns it back into a failed case.
 */
data Mock[A](runMock: Function[Recording, Pair[Either[String, A], Recording]])

implement Effect[Mock] {
   def pure[A](a: A): Mock[A] = Mock(r -> Pair(Right(a), r))

   def flatMap[A, B](f: Function[A, Mock[B]], fa: Mock[A]): Mock[B] =
      Mock(r -> foldPair(
         outcome -> after -> foldEither(e -> Pair(Left(e), after), a -> runMock(f(a))(after), outcome),
         runMock(fa)(r)
      ))

   def map[A, B](f: Function[A, B], fa: Mock[A]): Mock[B] =
      Mock(r -> foldPair(
         outcome -> after -> Pair(foldEither(e -> Left(e), a -> Right(f(a)), outcome), after),
         runMock(fa)(r)
      ))
}

/**
 * **One instance for every failure channel there will ever be**, including error types declared in the
 * project under test and the framework's own `AssertionError`. A project could not have written this for
 * its own error: an instance may only live with its ability or with a type argument, and a test module is
 * neither.
 */
implement[E ~ Show] Throw[E, Mock] {
   def raise[A](err: E): Mock[A] = Mock(r -> Pair(Left(show(err)), r))
}

/**
 * Arranging, as an effect: what makes `mocked { … }` need no world built outside it. A test performs these
 * through the words in `eliot.test.Mocked` rather than calling them directly.
 */
ability Mocking[F[_]] {
   /**
    * Tell the mocks one more thing, taking precedence over everything told before.
    */
   def arranged(arrangement: Arrangement): {Mocking} Unit

   /**
    * Replace the console input still to be handed out.
    */
   def queued(lines: List[String]): {Mocking} Unit

   /**
    * Forget every call recorded so far, keeping the arrangements — `reset` for verification only.
    */
   def forgotten: {Mocking} Unit

   /**
    * Expect `body` to raise, and to report something containing `expectedReport` — the mocked counterpart of
    * `expect`, which cannot serve here because it stacks a `ThrowCarrier` over the carrier and a double earns no
    * lift through it.
    *
    * Matching by containment rather than by equality is deliberate: a raise arrives at a mock already rendered by
    * its own `Show`, and a test should be able to pin the part it means without quoting a whole report.
    *
    * ```eliot
    * whenSpawning("ls-remote", failing(128, "no such repository"))
    * raising("failed with exit code 128", publishedTags(cacheRoot, cached))
    * ```
    *
    * The calls the body made before raising are kept, so they can still be verified afterwards.
    *
    * The body is a **suspended** slot (`{} Unit`) — the same shape `fold`'s arms and `catch`'s handler have — so
    * it is written inline where the carrier already is the mock's, and only run by this word. `Unit` rather than a
    * type parameter because nothing here reads the body's answer; a body that has one is spelled as a block that
    * ends in `unit`:
    *
    * ```eliot
    * raising("failed with exit code 128", {
    *    publishedTags(cacheRoot, cached)
    *    unit
    * })
    * ```
    */
   def raising(expectedReport: String, body: {} Unit): {Mocking} Unit
}

implement Mocking[Mock] {
   def arranged(arrangement: Arrangement): Mock[Unit] =
      Mock(r -> Pair(Right(unit), Recording(r.journal, prepend(r.arrangements, arrangement), r.pendingInput)))

   def queued(lines: List[String]): Mock[Unit] =
      Mock(r -> Pair(Right(unit), Recording(r.journal, r.arrangements, lines)))

   def forgotten: Mock[Unit] = Mock(r -> Pair(Right(unit), Recording(empty, r.arrangements, r.pendingInput)))

   def raising(expectedReport: String, body: Mock[Unit]): Mock[Unit] =
      Mock(recording -> checkedRaise(expectedReport, runMock(body)(recording)))
}

/**
 * Verifying, as an effect: what the mocks have been asked, in the order they were asked, each rendered as
 * one line (`printLine hello`, `/work$ git ls-remote --tags x`, `readFile /etc/hosts`).
 */
ability Calls[F[_]] {
   def recordedCalls: {Calls} List[String]
}

implement Calls[Mock] {
   def recordedCalls: Mock[List[String]] = Mock(r -> Pair(Right(r.journal), r))
}

/**
 * The console double: printing records the line, reading hands out what `whenReading` queued and answers
 * `None` once it is exhausted — end of input, which is what a real console answers there too.
 */
implement Console[Mock] {
   def printLine(s: String): Mock[Unit] = noting("printLine " ++ s)

   def readLine: Mock[Option[String]] =
      Mock(r -> Pair(
         Right(r.pendingInput.head),
         Recording(append(r.journal, "readLine"), r.arrangements, r.pendingInput.tail)
      ))
}

/**
 * The process double: nothing is spawned, the command *and the directory it would have run in* are
 * recorded — the half of an invocation a command line does not carry — and the answer is the most recent
 * `whenSpawning` whose fragment the command line contains, or a silent success.
 */
implement Process[Mock] {
   def run(command: List[String], workingDirectory: Path): Mock[ProcessResult] =
      Mock(r -> Pair(Right(spawnedFor(command, r)), afterSpawning(command, workingDirectory, r)))

   def runInheritingIo(command: List[String], workingDirectory: Path): Mock[Int] =
      Mock(r -> Pair(
         Right(spawnedFor(command, r).exitCode),
         afterSpawning(command, workingDirectory, r)
      ))
}

/**
 * The filesystem double: a virtual tree of whatever `withFile` and `withDirectory` put there, plus whatever
 * the code under test has written. Writing makes a file readable afterwards, creating a directory makes it
 * exist, deleting removes it — so a test can assert on what the code left behind and not only on what it
 * called.
 *
 * `foldCodePoints` is the one method that cannot answer honestly: reaching a string's code points needs a
 * primitive the base does not offer, so it records the call and answers the accumulator unchanged.
 */
implement FileSystem[Mock] {
   def readFile(path: Path): Mock[String] =
      Mock(r -> Pair(Right(contentAt(show(path), r)), noted("readFile " ++ show(path), r)))

   def writeFile(content: String, path: Path): Mock[Unit] =
      written("writeFile " ++ show(path), show(path), content)

   def appendFile(content: String, path: Path): Mock[Unit] =
      Mock(r -> Pair(
         Right(unit),
         holding(show(path), contentAt(show(path), r) ++ content, noted("appendFile " ++ show(path), r))
      ))

   def foldLines[B](initial: B, step: B => String => B, path: Path): Mock[B] =
      Mock(r -> Pair(Right(foldedLines(initial, step, show(path), r)), noted("foldLines " ++ show(path), r)))

   def foldCodePoints[B](initial: B, step: B => Int => B, path: Path): Mock[B] =
      Mock(r -> Pair(Right(initial), noted("foldCodePoints " ++ show(path), r)))

   def readLines(path: Path): Mock[List[String]] =
      Mock(r -> Pair(Right(linesAt(show(path), r)), noted("readLines " ++ show(path), r)))

   def exists(path: Path): Mock[Bool] =
      Mock(r -> Pair(Right(knownPaths(r).any(known -> known == show(path))), noted("exists " ++ show(path), r)))

   def isDirectory(path: Path): Mock[Bool] =
      Mock(r -> Pair(Right(directories(r).any(known -> known == show(path))), noted("isDirectory " ++ show(path), r)))

   def listDirectory(path: Path): Mock[List[Path]] =
      Mock(r -> Pair(Right(asPaths(entriesUnder(show(path), r))), noted("listDirectory " ++ show(path), r)))

   def walk(path: Path): Mock[List[Path]] =
      Mock(r -> Pair(Right(asPaths(everythingUnder(show(path), r))), noted("walk " ++ show(path), r)))

   def createDirectories(path: Path): Mock[Unit] =
      Mock(r -> Pair(
         Right(unit),
         arrangedIn(Existing(show(path)), noted("createDirectories " ++ show(path), r))
      ))

   def delete(path: Path): Mock[Unit] =
      Mock(r -> Pair(Right(unit), deleted(show(path), noted("delete " ++ show(path), r))))
}

/**
 * The environment double: the arguments, variables and working directory a test arranged, and the honest
 * empties where it arranged none.
 */
implement Environment[Mock] {
   def arguments: Mock[List[String]] = Mock(r -> Pair(Right(argumentsIn(r)), noted("arguments", r)))

   def environmentVariable(name: String): Mock[Option[String]] =
      Mock(r -> Pair(Right(variableIn(name, r)), noted("environmentVariable " ++ name, r)))

   def workingDirectory: Mock[Path] =
      Mock(r -> Pair(Right(path(workingPathIn(r))), noted("workingDirectory", r)))
}

/**
 * The log double: a log line is a call like any other, so `wasCalled("log ")` verifies one.
 */
implement Log[Mock] {
   def log(s: String): Mock[Unit] = noting("log " ++ s)
}

/**
 * A recording with nothing arranged, nothing asked and no input — where every mocked case starts.
 */
def emptyRecording: Recording = Recording(empty, empty, empty)

/**
 * Run `body` against `recording` and answer what it yielded, or the rendered failure that stopped it, and
 * the recording it left behind. The primitive `eliot.test.Mocked`'s words are built from.
 */
def mockOutcome[A](recording: Recording, body: {| Mock} A): Pair[Either[String, A], Recording] =
   runMock(body)(recording)

/**
 * Run `body` and answer only whether it raised, so a failure can be *expected*: `Some(report)` when it
 * raised, `None` when it completed. The recording it made is kept either way — a body that raises still
 * made the calls it made before raising, and a test may verify them.
 */
def raisedReport[A](body: {| Mock} A): Mock[Option[String]] =
   Mock(r -> foldPair(
      outcome -> after -> Pair(Right(foldEither(report -> Some(report), _ -> None, outcome)), after),
      runMock(body)(r)
   ))

/**
 * Fail the current mocked body with `report`, as a raise the discharge word will turn into a failed case.
 * The one thing `eliot.test.Mocked`'s verifications need that no ability offers.
 */
def mockFailure[A](report: String): Mock[A] = Mock(r -> Pair(Left(report), r))

private def noting(note: String): Mock[Unit] = Mock(r -> Pair(Right(unit), noted(note, r)))

private def written(note: String, at: String, content: String): Mock[Unit] =
   Mock(r -> Pair(Right(unit), holding(at, content, noted(note, r))))

private def noted(note: String, recording: Recording): Recording =
   Recording(append(recording.journal, note), recording.arrangements, recording.pendingInput)

private def arrangedIn(arrangement: Arrangement, recording: Recording): Recording =
   Recording(recording.journal, prepend(recording.arrangements, arrangement), recording.pendingInput)

private def holding(at: String, content: String, recording: Recording): Recording =
   arrangedIn(Holding(at, content), recording)

private def deleted(at: String, recording: Recording): Recording =
   Recording(
      recording.journal,
      recording.arrangements.filter(arrangement -> !(namesPath(arrangement, at))),
      recording.pendingInput
   )

private def namesPath(arrangement: Arrangement, at: String): Bool =
   foldOption(false, known -> known == at, pathOf(arrangement))

/**
 * The recording after a spawn: the call itself, plus anything a `whenSpawningCreates` said this command leaves
 * behind. Learned rather than recorded as a call of its own — the journal already carries the command, and the
 * directory is one the spawned program made.
 */
private def afterSpawning(command: List[String], workingDirectory: Path, recording: Recording): Recording =
   createdBySpawning(command, noted(spawnNote(command, workingDirectory), recording))

private def createdBySpawning(command: List[String], recording: Recording): Recording =
   creationsFor(command, recording).foldLeft(recording, created -> after -> arrangedIn(Existing(created), after))

private def creationsFor(command: List[String], recording: Recording): List[String] =
   recording.arrangements.foldLeft(empty, arrangement -> found -> withCreationOf(arrangement, command, found))

private def withCreationOf(
   arrangement: Arrangement,
   command: List[String],
   found: List[String]
): List[String] = arrangement match {
   case Creating(fragment, created) -> fold(contains(fragment, command.joined(" ")), append(found, created), found)
   case _                           -> found
}

private def spawnNote(command: List[String], workingDirectory: Path): String =
   show(workingDirectory) ++ "$ " ++ command.joined(" ")

/**
 * The most recent arrangement whose fragment the command line contains — most recent first, which is what
 * lets a body re-arm a mock between two acts — or a silent success where a test arranged none.
 */
private def spawnedFor(command: List[String], recording: Recording): ProcessResult =
   foldOption(
      ProcessResult(0, "", ""),
      arrangement -> spawnedResultOf(arrangement),
      recording.arrangements.find(arrangement -> spawns(arrangement, command.joined(" ")))
   )

private def spawns(arrangement: Arrangement, commandLine: String): Bool = arrangement match {
   case Spawning(fragment, _) -> contains(fragment, commandLine)
   case _                     -> false
}

private def spawnedResultOf(arrangement: Arrangement): ProcessResult = arrangement match {
   case Spawning(_, result) -> result
   case _                   -> ProcessResult(0, "", "")
}

private def contentAt(at: String, recording: Recording): String =
   foldOption("", arrangement -> contentOf(arrangement), recording.arrangements.find(arrangement -> holds(arrangement, at)))

private def holds(arrangement: Arrangement, at: String): Bool = arrangement match {
   case Holding(filePath, _) -> filePath == at
   case _                    -> false
}

private def contentOf(arrangement: Arrangement): String = arrangement match {
   case Holding(_, content) -> content
   case _                   -> ""
}

/**
 * The fold itself, out here where there is no carrier: a `{}`-rowed combinator called inside an instance method
 * would be a computation on the mock's own carrier, and `Right` takes a payload.
 */
private def foldedLines[B](initial: B, step: B => String => B, at: String, recording: Recording): B =
   linesAt(at, recording).foldLeft(initial, line -> acc -> step(acc)(line))

private def asPaths(names: List[String]): List[Path] = names.map(path)

private def linesAt(at: String, recording: Recording): List[String] =
   fold(contentAt(at, recording) == "", empty, split("\n", contentAt(at, recording)))

/**
 * Every path the virtual tree knows about — files a test arranged or the code wrote, and directories.
 */
private def knownPaths(recording: Recording): List[String] =
   recording.arrangements.foldLeft(empty, arrangement -> known -> withPathOf(arrangement, known))

private def withPathOf(arrangement: Arrangement, known: List[String]): List[String] =
   foldOption(known, at -> append(known, at), pathOf(arrangement))

private def pathOf(arrangement: Arrangement): Option[String] = arrangement match {
   case Holding(filePath, _)  -> Some(filePath)
   case Existing(existingAt)  -> Some(existingAt)
   case _                     -> None
}

private def directories(recording: Recording): List[String] =
   recording.arrangements.foldLeft(empty, arrangement -> known -> withDirectoryOf(arrangement, known))

private def withDirectoryOf(arrangement: Arrangement, known: List[String]): List[String] = arrangement match {
   case Existing(existingAt) -> append(known, existingAt)
   case _                    -> known
}

/**
 * The immediate entries of a directory: known paths under it whose remainder names no further directory.
 */
private def entriesUnder(directory: String, recording: Recording): List[String] =
   everythingUnder(directory, recording).filter(known -> isImmediate(directory, known))

private def isImmediate(directory: String, known: String): Bool =
   !contains("/", known.drop(directory.length + 1))

private def everythingUnder(directory: String, recording: Recording): List[String] =
   knownPaths(recording).filter(known -> startsWith(directory ++ "/", known))

private def argumentsIn(recording: Recording): List[String] =
   foldOption(
      empty,
      arrangement -> passedOf(arrangement),
      recording.arrangements.find(arrangement -> passes(arrangement))
   )

private def passes(arrangement: Arrangement): Bool = arrangement match {
   case Passing(_) -> true
   case _          -> false
}

private def passedOf(arrangement: Arrangement): List[String] = arrangement match {
   case Passing(passed) -> passed
   case _               -> empty
}

private def variableIn(name: String, recording: Recording): Option[String] =
   foldOption(
      None,
      arrangement -> Some(valueOf(arrangement)),
      recording.arrangements.find(arrangement -> defines(arrangement, name))
   )

private def defines(arrangement: Arrangement, name: String): Bool = arrangement match {
   case Defining(variableName, _) -> variableName == name
   case _                         -> false
}

private def valueOf(arrangement: Arrangement): String = arrangement match {
   case Defining(_, value) -> value
   case _                  -> ""
}

private def workingPathIn(recording: Recording): String =
   foldOption(
      ".",
      arrangement -> workingOf(arrangement),
      recording.arrangements.find(arrangement -> worksIn(arrangement))
   )

private def worksIn(arrangement: Arrangement): Bool = arrangement match {
   case WorkingIn(_) -> true
   case _            -> false
}

private def workingOf(arrangement: Arrangement): String = arrangement match {
   case WorkingIn(at) -> at
   case _             -> "."
}

private def matchingCalls(fragment: String): {Calls} List[String] =
   recordedCalls.filter(call -> contains(fragment, call))

private def unexpectedCalls(fragments: List[String]): {Calls} List[String] =
   recordedCalls.filter(call -> !(fragments.any(fragment -> contains(fragment, call))))

private def missing(what: String): {Calls, Throw[AssertionError]} Unit =
   raise(Failed("expected " ++ what ++ ", but the calls were: " ++ describedCalls))

private def describedCalls: {Calls} String = fold(recordedCalls.isEmpty, "none", calls)

private def countMismatch(count: Int, fragment: String, qualifier: String): {Calls, Throw[AssertionError]} Unit =
   raise(NotEqual(
      qualifier ++ " " ++ show(count) ++ " calls containing '" ++ fragment ++ "'",
      show(callCount(fragment)) ++ " (" ++ describedCalls ++ ")"
   ))

/**
 * One step of the in-order check: a call that matches the next fragment still expected consumes it, and
 * anything else leaves the expectation where it was.
 */
private def advanced(call: String, pending: List[String]): List[String] =
   foldOption(pending, next -> fold(contains(next, call), pending.tail, pending), pending.head)

private def checkedRaise(
   expectedReport: String,
   outcome: Pair[Either[String, Unit], Recording]
): Pair[Either[String, Unit], Recording] =
   foldPair(result -> after -> Pair(verdictOf(expectedReport, result), after), outcome)

private def verdictOf(expectedReport: String, result: Either[String, Unit]): Either[String, Unit] =
   result.foldEither(
      report -> matchedReport(expectedReport, report),
      _ -> Left("expected a raise reporting '" ++ expectedReport ++ "', but nothing was raised")
   )

private def matchedReport(expectedReport: String, report: String): Either[String, Unit] =
   fold(
      contains(expectedReport, report),
      Right(unit),
      Left("expected a raise reporting '" ++ expectedReport ++ "', but got '" ++ report ++ "'")
   )
