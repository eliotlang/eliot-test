import eliot.collection.List
import eliot.file.Path
import eliot.file.File
import eliot.system.Process
import eliot.system.Environment
import eliot.test.Assertion

/**
 * Test doubles for the effects of the standard library — `Console`, `Log`, `FileSystem`, `Process` and
 * `Environment` — and the words a test uses to *arrange* what they answer and to *verify* what they were asked.
 *
 * ```eliot
 * "publishedTags" should "clone a mirror it has not seen" in mocked {
 *    whenSpawning("ls-remote", succeeding(listing))          // arrange
 *
 *    val published = publishedTags(cacheRoot, cached)        // act
 *
 *    published.size shouldBe 2                               // assert on the answer
 *    wasCalledOnce("git clone --mirror")                     // ...and on what was asked
 * }
 * ```
 *
 * **Calls are matched by words.** Every verification, and `whenSpawning`, takes a *fragment*: a call matches when
 * the fragment's words appear in the call's description, next to each other and in order. So `wasCalled("ls-remote")`
 * matches `/work$ git ls-remote --tags x` without spelling out the whole command, while `wasCalled("log")` does not
 * match `printLine catalog`. A call is described as the operation followed by its arguments — `printLine hello`,
 * `readFile /etc/hosts` — except a spawned process, which is the directory it ran in, then `$`, then the command
 * line: `/work$ git fetch`.
 *
 * **The file system is a small in-memory tree.** `withFile` and `withDirectory` put things in it, and the code
 * under test changes it by writing, creating and deleting. A directory holding a file exists even when nobody
 * created it explicitly.
 *
 * **What the doubles cannot do yet** is fail: the standard library's `IoError` has no constructor a test could
 * call, so reading a file that does not exist answers `""` instead of raising, and no arrangement can make a call
 * raise an `IoError`. Where answering would hide a difference from the platform that a test must not rely on —
 * deleting a non-empty directory or a path nothing is at, folding a file's code points — the double fails the case
 * instead, naming the call.
 */

/**
 * Run `body` against the doubles: `"…" should "…" in mocked { … }`.
 *
 * Every case starts with nothing arranged and nothing recorded. The body may perform any of the mocked effects,
 * arrange, verify and assert, in any order. An effect not mocked here is a compile error, so a mocked case can
 * never reach a real file or a real process by accident.
 */
def mocked(
      body: {Console, Log, FileSystem, Process, Environment, Mocking, Calls, Throw[IoError], Throw[AssertionError]} Unit
         with mockConsole with mockLog with mockFileSystem with mockProcess with mockEnvironment
   ): {Throw[AssertionError]} Unit =
   runStateToValue(emptyRecording, catch[IoError, Unit](body, e -> fail("unexpected I/O failure: " ++ show(e))))

/**
 * Arrange what a spawned process answers: a command matching `commandFragment` answers `result`.
 *
 * ```eliot
 * whenSpawning("ls-remote", succeeding(listing))
 * whenSpawning("clone --mirror", failing(128, "no such repository"))
 * ```
 *
 * When several arrangements match, the most recent one wins, so a test may act, re-arrange and act again. A
 * command nothing matches succeeds with no output.
 */
def whenSpawning(commandFragment: String, result: ProcessResult): {Mocking} Unit =
   arranged(Spawning(commandFragment, result))

/**
 * A process that exited with 0 and printed `output`.
 */
def succeeding(output: String): ProcessResult = ProcessResult(0, output, "")

/**
 * A process that exited with `exitCode` and printed `diagnostics` to standard error.
 */
def failing(exitCode: Int, diagnostics: String): ProcessResult = ProcessResult(exitCode, "", diagnostics)

/**
 * A process that exited with `exitCode` and printed `output` — for an exit code that is neither plain success nor
 * plain failure, such as `diff`'s 1.
 */
def exiting(exitCode: Int, output: String): ProcessResult = ProcessResult(exitCode, output, "")

/**
 * Arrange that a command matching `commandFragment` leaves the directory `created` behind, the way `git clone`
 * does, so a test can check that the code under test does not clone twice:
 *
 * ```eliot
 * whenSpawningCreates("clone --mirror", path("target/cache/github.com/x/foo"))
 * ```
 *
 * It decides only what the command leaves behind; combine it with `whenSpawning` to decide what it prints too.
 * What a command leaves behind is left only when it **exits 0** — a clone that failed leaves nothing — and, like
 * `whenSpawning`, the most recent matching `whenSpawningCreates` or `whenSpawningWrites` wins, so a test may
 * re-arm what a command leaves between two runs of it.
 */
def whenSpawningCreates(commandFragment: String, created: Path): {Mocking} Unit =
   arranged(Creating(commandFragment, DirectoryEntry(keyOf(created))))

/**
 * Arrange that a command matching `commandFragment` leaves the file `written` behind, holding `content`, the way
 * `curl --output` does, so the code under test can read, hash or delete what it downloaded:
 *
 * ```eliot
 * whenSpawningWrites("curl", path("target/cache/eliot-jvm.zip.download"), "")
 * ```
 *
 * The file replaces whatever was at its path, and the directories it is in exist from then on. It is left behind
 * on the terms `whenSpawningCreates`'s directory is: only when the command exits 0, and only by the most recent
 * matching arrangement of either.
 */
def whenSpawningWrites(commandFragment: String, written: Path, content: String): {Mocking} Unit =
   arranged(Creating(commandFragment, FileEntry(keyOf(written), content)))

/**
 * Arrange the console input: `readLine` answers `lines` one by one, then `None`, which is end of input. Replaces
 * whatever input was left.
 */
def whenReading(lines: List[String]): {Mocking} Unit = queued(lines)

/**
 * Put a file holding `content` into the file system.
 */
def withFile(at: Path, content: String): {Mocking} Unit = placed(FileEntry(keyOf(at), content))

/**
 * Put a directory into the file system.
 */
def withDirectory(at: Path): {Mocking} Unit = placed(DirectoryEntry(keyOf(at)))

/**
 * Arrange an environment variable.
 */
def withVariable(name: String, value: String): {Mocking} Unit = arranged(Defining(name, value))

/**
 * Arrange the program's command-line arguments.
 */
def withArguments(passed: List[String]): {Mocking} Unit = arranged(Passing(passed))

/**
 * Arrange the working directory the program sees. Without it, the working directory is `.`.
 */
def withWorkingDirectory(at: Path): {Mocking} Unit = arranged(WorkingIn(keyOf(at)))

/**
 * Every call made so far, oldest first, joined by `"; "`:
 *
 * ```eliot
 * calls shouldBe "readLine; printLine Hello, Bob!"
 * ```
 */
def calls: {Calls} String = recordedCalls.map(described).joined("; ")

/**
 * The calls matching `fragment`, joined the same way as `calls` — for asserting on the arguments of a call
 * rather than on the mere fact of it:
 *
 * ```eliot
 * callsMatching("git clone") shouldBe ".$ git clone --mirror https://github.com/x/foo target/cache"
 * ```
 */
def callsMatching(fragment: String): {Calls} String = matchingCalls(fragment).map(described).joined("; ")

/**
 * The most recent call, or `"<none>"` when nothing has been called.
 */
def lastCall: {Calls} String = recordedCalls.last.mapOption(described) orElse "<none>"

/**
 * How many calls matched `fragment`.
 */
def callCount(fragment: String): {Calls} Int = matchingCalls(fragment).size

/**
 * Forget the calls recorded so far, keeping everything arranged — for verifying the second half of a scenario
 * on its own.
 */
def forgetCalls: {Mocking} Unit = forgotten

/**
 * Verify that at least one call matched `fragment`.
 */
def wasCalled(fragment: String): {Calls, Throw[AssertionError]} Unit =
   when(callCount(fragment) == 0) fail(
      "expected a call containing '" ++ fragment ++ "', but the calls were: " ++ callsOrNone
   )

/**
 * Verify that no call matched `fragment` — that the code under test did *not* do something.
 */
def wasNeverCalled(fragment: String): {Calls, Throw[AssertionError]} Unit =
   unless(callCount(fragment) == 0) fail(
      "expected no call containing '" ++ fragment ++ "', but found " ++ callsMatching(fragment)
   )

/**
 * Verify that exactly one call matched `fragment`.
 */
def wasCalledOnce(fragment: String): {Calls, Throw[AssertionError]} Unit = wasCalledTimes(1, fragment)

/**
 * Verify that exactly `count` calls matched `fragment`.
 */
def wasCalledTimes(count: Int, fragment: String): {Calls, Throw[AssertionError]} Unit =
   unless(callCount(fragment) == count) countMismatch("exactly", count, fragment)

/**
 * Verify that at least `count` calls matched `fragment`.
 */
def wasCalledAtLeast(count: Int, fragment: String): {Calls, Throw[AssertionError]} Unit =
   unless(callCount(fragment) >= count) countMismatch("at least", count, fragment)

/**
 * Verify that at most `count` calls matched `fragment`.
 */
def wasCalledAtMost(count: Int, fragment: String): {Calls, Throw[AssertionError]} Unit =
   unless(callCount(fragment) <= count) countMismatch("at most", count, fragment)

/**
 * Verify that calls matching each of `fragments` happened in this order. Other calls may happen in between.
 */
def wereCalledInOrder(fragments: List[String]): {Calls, Throw[AssertionError]} Unit =
   unless(fragmentsNotSeenInOrder(fragments, recordedCalls).isEmpty) fail(
      "expected calls in order: " ++ fragments.joined(", ") ++ "; got: " ++ callsOrNone
   )

/**
 * Verify that nothing was called at all.
 */
def nothingWasCalled: {Calls, Throw[AssertionError]} Unit =
   unless(recordedCalls.isEmpty) fail("expected no calls, but found " ++ calls)

/**
 * Verify that every call matched one of `fragments` — that the code under test did what was expected and nothing
 * else.
 */
def onlyTheseWereCalled(fragments: List[String]): {Calls, Throw[AssertionError]} Unit = {
   val unexpected = recordedCalls.filter(call -> !(fragments.any(fragment -> matches(fragment, call))))

   unless(unexpected.isEmpty) fail("unexpected calls: " ++ unexpected.map(described).joined("; "))
}

/**
 * What the file at `at` holds now, or `None` where there is no file — read from the in-memory tree **without
 * recording a call**, so checking what the code under test wrote does not change what `calls` and the
 * verifications see:
 *
 * ```eliot
 * writeDigest(archive)                                         // act
 *
 * (fileContentAt(path("cache/x.sha256")) orElse "<missing>") shouldBe "beef\n"
 * onlyTheseWereCalled(singleton("writeFile"))                  // the check above was not a call
 * ```
 *
 * `readFile` through the double answers the same content, and is recorded as the code under test's calls are.
 */
def fileContentAt(at: Path): {Calls} Option[String] = recordedFiles.findMap(entry -> fileContent(keyOf(at), entry))

/**
 * Whether anything — a file, or a directory, put there or implied by something inside it — is at `at` now, read
 * without recording a call. `exists` through the double answers the same and is recorded.
 */
def existsAt(at: Path): {Calls} Bool = existsIn(keyOf(at), recordedFiles)

/**
 * The files inside `directory` now, however deep, read without recording a call. `walk` through the double
 * answers the same and is recorded.
 */
def filesUnder(directory: Path): {Calls} List[Path] = filePathsUnder(keyOf(directory), recordedFiles).asPaths

/**
 * Arranging, as an effect. The `when…` and `with…` words above perform it; a shared arrangement is an ordinary
 * definition declaring it, such as `def mirrorReady: {Mocking} Unit = withDirectory(path("target/cache"))`.
 *
 * Its operations take this module's internal types, so a test names the effect but calls the words above.
 */
effect Mocking {
   def arranged(arrangement: Arrangement): Unit

   def placed(entry: Entry): Unit

   def queued(lines: List[String]): Unit

   def forgotten: Unit
}

implement Mocking {
   def arranged(arrangement: Arrangement): {State[Recording]} Unit =
      updateState(r -> r.setArrangements(prepend(r.arrangements, arrangement)))

   def placed(entry: Entry): {State[Recording]} Unit = updateState(r -> r.setTree(placedIn(entry, r.fileTree)))

   def queued(lines: List[String]): {State[Recording]} Unit = updateState(r -> r.setPendingInput(lines))

   def forgotten: {State[Recording]} Unit = updateState(r -> r.setJournal(empty))
}

/**
 * Verifying, as an effect: what the doubles have been asked, oldest first, and what the file system holds now.
 * Reading either records nothing. A test names the effect and reads it through the words above.
 */
effect Calls {
   def recordedCalls: List[Call]

   def recordedFiles: List[Entry]
}

implement Calls {
   def recordedCalls: {State[Recording]} List[Call] = state.journal

   def recordedFiles: {State[Recording]} List[Entry] = state.fileTree
}

/**
 * The console double: `printLine` is recorded, `readLine` answers what `whenReading` arranged.
 */
implement mockConsole: Console {
   def printLine(s: String): {State[Recording]} Unit = noting(asked("printLine", s))

   def readLine: {State[Recording]} Option[String] =
      recorded(r -> noted(askedNothing("readLine"), r).setPendingInput(r.pendingInput.tail), r -> r.pendingInput.head)
}

/**
 * The log double: a logged line is recorded like any other call, as `log <line>`.
 */
implement mockLog: Log {
   def log(s: String): {State[Recording]} Unit = noting(asked("log", s))
}

/**
 * The process double: nothing is spawned. The command is recorded with the directory it would have run in, and
 * answered by the most recent matching `whenSpawning`.
 */
implement mockProcess: Process {
   def run(command: List[String], workingDirectory: Path): {State[Recording]} ProcessResult =
      spawning(Spawned(keyOf(workingDirectory), command))

   def runInheritingIo(command: List[String], workingDirectory: Path): {State[Recording]} Int =
      spawning(Spawned(keyOf(workingDirectory), command)).exitCode

   def registerExitCode(code: Int): {State[Recording]} Unit = noting(asked("registerExitCode", show(code)))
}

/**
 * The file system double, over the in-memory tree. Every operation is recorded as its name and the path.
 *
 * Lines end the way the platform reads them: at `\n`, `\r\n` or `\r`, and a final line ending ends the last line
 * rather than starting an empty one.
 *
 * `delete` removes one thing, as the platform does: a directory with something inside it, or a path nothing is
 * at, fails the case. `foldCodePoints` fails the case too, after recording the call: the standard library offers
 * no way to reach a string's code points from Eliot code, and answering `initial` would read as a right answer.
 */
implement mockFileSystem: FileSystem {
   def readFile(path: Path): {State[Recording]} String =
      answering(about("readFile", path), r -> contentAt(keyOf(path), r.fileTree))

   def writeFile(content: String, path: Path): {State[Recording]} Unit =
      changingFiles(about("writeFile", path), tree -> placedIn(FileEntry(keyOf(path), content), tree))

   def appendFile(content: String, path: Path): {State[Recording]} Unit =
      changingFiles(about("appendFile", path), tree -> placedIn(FileEntry(keyOf(path), contentAt(keyOf(path), tree) ++ content), tree))

   def foldLines[B](initial: B, step: B => String => B, path: Path): {State[Recording]} B =
      answering(about("foldLines", path), r -> linesAt(keyOf(path), r.fileTree).foldLeft(initial, line -> acc -> step(acc)(line)))

   def foldCodePoints[B](initial: B, step: B => Int => B, path: Path): {State[Recording], Throw[AssertionError]} B = {
      noting(about("foldCodePoints", path))
      fail(described(about("foldCodePoints", path)) ++ ": the mocked FileSystem cannot fold a file's code points")

      initial
   }

   def readLines(path: Path): {State[Recording]} List[String] =
      answering(about("readLines", path), r -> linesAt(keyOf(path), r.fileTree))

   def exists(path: Path): {State[Recording]} Bool =
      answering(about("exists", path), r -> existsIn(keyOf(path), r.fileTree))

   def isDirectory(path: Path): {State[Recording]} Bool =
      answering(about("isDirectory", path), r -> isDirectoryIn(keyOf(path), r.fileTree))

   def listDirectory(path: Path): {State[Recording]} List[Path] =
      answering(about("listDirectory", path), r -> entriesOf(keyOf(path), r.fileTree).asPaths)

   def walk(path: Path): {State[Recording]} List[Path] =
      answering(about("walk", path), r -> filePathsUnder(keyOf(path), r.fileTree).asPaths)

   def createDirectories(path: Path): {State[Recording]} Unit =
      changingFiles(about("createDirectories", path), tree -> placedIn(DirectoryEntry(keyOf(path)), tree))

   def delete(path: Path): {State[Recording], Throw[AssertionError]} Unit = {
      val tree = state.fileTree

      changingFiles(about("delete", path), t -> removedFrom(keyOf(path), t))
      unless(existsIn(keyOf(path), tree)) refused(about("delete", path), "there is nothing at that path")
      unless(entriesOf(keyOf(path), tree).isEmpty) refused(about("delete", path), "the directory is not empty")
   }
}

/**
 * The environment double: the arguments, variables and working directory a test arranged, and empty answers
 * where it arranged none.
 */
implement mockEnvironment: Environment {
   def arguments: {State[Recording]} List[String] =
      answering(askedNothing("arguments"), r -> r.arrangements.findMap(argumentsArranged) orElse empty)

   def environmentVariable(name: String): {State[Recording]} Option[String] =
      answering(asked("environmentVariable", name), r -> r.arrangements.findMap(arrangement -> variableArranged(name, arrangement)))

   def workingDirectory: {State[Recording]} Path =
      answering(askedNothing("workingDirectory"), r -> path(r.arrangements.findMap(workingDirectoryArranged) orElse "."))
}

// ---- What the doubles keep: everything below is internal ------------------------------------------------------

/**
 * One call a double was asked: an operation with its arguments, or a process spawned in a directory.
 */
private data Call = Asked(operationName: String, operationArguments: List[String]) | Spawned(spawnDirectory: String, commandLine: List[String])

/**
 * Something a test arranged, other than the file system's content. The most recent one wins.
 */
private data Arrangement =
   Spawning(commandFragment: String, spawnedResult: ProcessResult) |
   Creating(creatingFragment: String, createdEntry: Entry) |
   Defining(variableName: String, variableValue: String) |
   Passing(passedArguments: List[String]) |
   WorkingIn(workingPath: String)

/**
 * One thing in the in-memory file system: a file and its content, or a directory.
 */
private data Entry = FileEntry(filePath: String, fileContent: String) | DirectoryEntry(directoryPath: String)

/**
 * Everything a mocked case has done so far: the calls, oldest first; the arrangements, most recent first; the
 * file system; and the console input not yet read.
 */
private data Recording(journal: List[Call], arrangements: List[Arrangement], fileTree: List[Entry], pendingInput: List[String])

private def emptyRecording: Recording = Recording(empty, empty, empty, empty)

private def setJournal(newJournal: List[Call], r: Recording): Recording =
   Recording(newJournal, r.arrangements, r.fileTree, r.pendingInput)

private def setArrangements(newArrangements: List[Arrangement], r: Recording): Recording =
   Recording(r.journal, newArrangements, r.fileTree, r.pendingInput)

private def setTree(newTree: List[Entry], r: Recording): Recording =
   Recording(r.journal, r.arrangements, newTree, r.pendingInput)

private def setPendingInput(newInput: List[String], r: Recording): Recording =
   Recording(r.journal, r.arrangements, r.fileTree, newInput)

// ---- How a double records and answers ---------------------------------------------------------------------------

/**
 * The shape of every double's operation: change the recording with `update`, and answer from the recording as it
 * was *before* the call.
 */
private def recorded[A](update: Recording => Recording, answer: Recording => A): {State[Recording]} A = {
   val before = state

   putState(update(before))

   answer(before)
}

/**
 * Record `call` and answer from the recording.
 */
private def answering[A](call: Call, answer: Recording => A): {State[Recording]} A = recorded(r -> noted(call, r), answer)

/**
 * Record `call` and change the file system with `change`.
 */
private def changingFiles(call: Call, change: List[Entry] => List[Entry]): {State[Recording]} Unit =
   updateState(r -> noted(call, r).setTree(change(r.fileTree)))

/**
 * Record `call`, and nothing else.
 */
private def noting(call: Call): {State[Recording]} Unit = updateState(r -> noted(call, r))

private def noted(call: Call, r: Recording): Recording = r.setJournal(append(r.journal, call))

private def asked(operation: String, argument: String): Call = Asked(operation, singleton(argument))

private def askedNothing(operation: String): Call = Asked(operation, empty)

private def about(operation: String, at: Path): Call = asked(operation, keyOf(at))

// ---- Describing and matching calls ------------------------------------------------------------------------------

/**
 * How a call reads: `printLine hello`, `readFile /etc/hosts`, `/work$ git fetch`.
 */
private def described(call: Call): String = call match {
   case Asked(operation, arguments)      -> prepend(arguments, operation).joined(" ")
   case Spawned(directory, commandLine) -> directory ++ "$ " ++ commandLine.joined(" ")
}

/**
 * Whether `fragment`'s words appear in the call's description, next to each other and in order. Padding both
 * sides with a space is what makes `log` match the word `log` and not the end of `catalog`.
 */
private def matches(fragment: String, call: Call): Bool =
   isBlank(fragment) || contains(paddedWords(fragment), paddedWords(described(call)))

private def paddedWords(text: String): String = " " ++ words(text).joined(" ") ++ " "

private def matchingCalls(fragment: String): {Calls} List[Call] = recordedCalls.filter(call -> matches(fragment, call))

private def callsOrNone: {Calls} String = if(recordedCalls.isEmpty) "none" else calls

private def countMismatch(qualifier: String, count: Int, fragment: String): {Calls, Throw[AssertionError]} Unit =
   raise(NotEqual(
      qualifier ++ " " ++ show(count) ++ " calls containing '" ++ fragment ++ "'",
      show(callCount(fragment)) ++ " (" ++ callsOrNone ++ ")"
   ))

/**
 * The fragments still waiting after walking through `history`: each call matching the first waiting fragment
 * removes it. Empty exactly when the fragments were all seen, in order.
 */
private def fragmentsNotSeenInOrder(fragments: List[String], history: List[Call]): List[String] =
   history.foldLeft(fragments, call -> waiting -> if(waiting.head.anyOption(next -> matches(next, call))) waiting.tail else waiting)

// ---- Processes --------------------------------------------------------------------------------------------------

/**
 * Record `spawned` and answer what was arranged for it.
 */
private def spawning(spawned: Call): {State[Recording]} ProcessResult =
   recorded(r -> spawnedIn(spawned, r), r -> resultFor(spawned, r))

/**
 * The recording after `spawned` ran: the call is recorded, and what it leaves behind is now in the file system.
 */
private def spawnedIn(spawned: Call, r: Recording): Recording =
   noted(spawned, r).setTree(leftBehind(spawned, r).mapOption(entry -> placedIn(entry, r.fileTree)) orElse r.fileTree)

/**
 * What `spawned` leaves behind: the most recent matching `whenSpawningCreates` or `whenSpawningWrites`, and
 * nothing for a command that did not exit 0.
 */
private def leftBehind(spawned: Call, r: Recording): Option[Entry] =
   if(resultFor(spawned, r).exitCode == 0) r.arrangements.findMap(arrangement -> createdBy(spawned, arrangement)) else none

private def createdBy(spawned: Call, arrangement: Arrangement): Option[Entry] = arrangement match {
   case Creating(fragment, created) -> someIf(matches(fragment, spawned)) created
   case _                           -> none
}

private def resultFor(spawned: Call, r: Recording): ProcessResult =
   r.arrangements.findMap(arrangement -> resultIfMatching(spawned, arrangement)) orElse succeeding("")

private def resultIfMatching(spawned: Call, arrangement: Arrangement): Option[ProcessResult] = arrangement match {
   case Spawning(fragment, result) -> someIf(matches(fragment, spawned)) result
   case _                          -> none
}

// ---- The environment --------------------------------------------------------------------------------------------

private def argumentsArranged(arrangement: Arrangement): Option[List[String]] = arrangement match {
   case Passing(passed) -> some(passed)
   case _               -> none
}

private def variableArranged(name: String, arrangement: Arrangement): Option[String] = arrangement match {
   case Defining(variableName, value) -> someIf(variableName == name) value
   case _                             -> none
}

private def workingDirectoryArranged(arrangement: Arrangement): Option[String] = arrangement match {
   case WorkingIn(at) -> some(at)
   case _             -> none
}

// ---- The in-memory file system ----------------------------------------------------------------------------------

/**
 * A path as the tree keys it: as shown, without a trailing `/`, so `/tmp/dir/` and `/tmp/dir` are one directory.
 */
private def keyOf(at: Path): String = withoutTrailingSlash(show(at))

private def withoutTrailingSlash(text: String): String =
   if(endsWith("/", text) && length(text) > 1) take(length(text) - 1, text) else text

private def asPaths(keys: List[String]): List[Path] = keys.map(path)

private def entryPath(entry: Entry): String = entry match {
   case FileEntry(at, _)    -> at
   case DirectoryEntry(at)  -> at
}

/**
 * Whether `at` lies inside `directory`, however deep.
 */
private def isInside(directory: String, at: String): Bool = startsWith(insidePrefix(directory), at)

/**
 * What every path inside `directory` starts with: `directory` and a `/`.
 */
private def insidePrefix(directory: String): String = if(endsWith("/", directory)) directory else directory ++ "/"

/**
 * `tree` with `entry` added, replacing whatever was at its path.
 */
private def placedIn(entry: Entry, tree: List[Entry]): List[Entry] =
   prepend(tree.filter(other -> entryPath(other) != entryPath(entry)), entry)

/**
 * `tree` without the entry at `at`. Whatever is inside it stays: `delete` refuses a directory that is not empty.
 */
private def removedFrom(at: String, tree: List[Entry]): List[Entry] = tree.filter(entry -> entryPath(entry) != at)

/**
 * Fail the case where the platform's `FileSystem` would raise an `IoError`, which a double cannot construct yet.
 */
private def refused(call: Call, reason: String): {Throw[AssertionError]} Unit =
   fail(described(call) ++ ": " ++ reason ++ "; the platform raises an IoError here")

private def contentAt(at: String, tree: List[Entry]): String = tree.findMap(entry -> fileContent(at, entry)) orElse ""

private def fileContent(at: String, entry: Entry): Option[String] = entry match {
   case FileEntry(filePath, content) -> someIf(filePath == at) content
   case _                            -> none
}

private def linesAt(at: String, tree: List[Entry]): List[String] = linesOf(contentAt(at, tree))

/**
 * `content`'s lines as the platform reads them: `\n`, `\r\n` and `\r` each end a line, and a line ending at the
 * very end ends the last line rather than starting an empty one — `"a\nb\n"` is two lines, `"\n"` one empty line.
 */
private def linesOf(content: String): List[String] = {
   val unified = content.replace("\r\n", "\n").replace("\r", "\n")

   if(unified == "") empty else if(endsWith("\n", unified)) split("\n", unified).dropLast else split("\n", unified)
}

/**
 * Something exists at `at` when it was put there, or when anything is inside it.
 */
private def existsIn(at: String, tree: List[Entry]): Bool =
   tree.any(entry -> entryPath(entry) == at || isInside(at, entryPath(entry)))

/**
 * A directory exists at `at` when one was put there, or when anything is inside it.
 */
private def isDirectoryIn(at: String, tree: List[Entry]): Bool =
   tree.any(entry -> isDirectoryEntry(at, entry) || isInside(at, entryPath(entry)))

private def isDirectoryEntry(at: String, entry: Entry): Bool = entry match {
   case DirectoryEntry(directoryPath) -> directoryPath == at
   case _                             -> false
}

/**
 * The files inside `directory`, however deep — what `walk` answers.
 */
private def filePathsUnder(directory: String, tree: List[Entry]): List[String] =
   tree.filterMap(entry -> filePathInside(directory, entry))

private def filePathInside(directory: String, entry: Entry): Option[String] = entry match {
   case FileEntry(filePath, _) -> someIf(isInside(directory, filePath)) filePath
   case _                      -> none
}

/**
 * The immediate entries of `directory`: for everything inside it, the first step down from it, each once. A
 * file at `/a/b/c` makes `/a/b` an entry of `/a`.
 */
private def entriesOf(directory: String, tree: List[Entry]): List[String] =
   tree
      .map(entryPath)
      .filter(at -> isInside(directory, at))
      .map(at -> firstStepInto(directory, at))
      .foldLeft(empty, entry -> seen -> if(seen.includes(entry)) seen else append(seen, entry))

private def firstStepInto(directory: String, at: String): String =
   insidePrefix(directory) ++ before("/", drop(length(insidePrefix(directory)), at))
