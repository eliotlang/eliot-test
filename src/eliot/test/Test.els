import eliot.effect.Throw
import eliot.lang.Id
import eliot.test.Assertion

/**
 * A single test case to run: a `name` to report it under, and a `body` that runs the test and raises an
 * `AssertionError` if it fails.
 *
 * The pinned effect-row field `{Throw[AssertionError] | Id} Unit` stores the body as a concrete suspended
 * computation on the pure identity base `Id`: a body may only *assert* (raise an `AssertionError`) — it can
 * never perform I/O. Every test module declares its cases under the name `testCases` with this type, so the
 * runner can gather them all with `namedValues`.
 */
data TestCase(name: String, body: {Throw[AssertionError] | Id} Unit)

/**
 * A definition of a test case. The "what" and "what should it do" part.
 */
data TestCaseDefinition(what: String, acceptanceDescription: String)

infix none def should(what: String, acceptanceDescription: String): TestCaseDefinition =
   TestCaseDefinition(what, acceptanceDescription)

/**
 * Give a body to a test case definition.
 */
infix none below should def in(definition: TestCaseDefinition, body: {Throw[AssertionError] | Id} Unit): TestCase =
   TestCase(definition.what, body)
