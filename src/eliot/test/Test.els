import eliot.collection.List
import eliot.test.Assertion

/**
 * What a test case is about: the `subject` under test and the `should` phrase naming the expectation.
 *
 * ```eliot
 * "greeting" should "address the name it was given"     // a TestCase("greeting", "address the name it was given")
 * ```
 */
data TestCase(subject: String, shouldPhrase: String)

/**
 * What running one test body came to: it `Passed`, or it `FailedWith` the assertion error it raised.
 */
data Outcome = Passed | FailedWith(assertionError: AssertionError)

/**
 * One test case and its outcome — what a suite collects, and what the runner reports.
 */
data TestResult(testCase: TestCase, outcome: Outcome)

/**
 * Whether this case passed.
 */
def passed(result: TestResult): Bool = result.outcome match {
   case Passed        -> true
   case FailedWith(_) -> false
}

/**
 * The return type of a suite. Declare one per module, named `testCases`, and the runner finds it:
 *
 * ```eliot
 * def testCases: Test = {                       // the cases may assert, and nothing else
 *    "shouldBe" should "pass for two equal strings" in {
 *       "hello" shouldBe "hello"
 *    }
 * }
 *
 * def testCases: {Console} Test = { … }         // the cases may also print, for real
 * ```
 *
 * A suite collects its cases' results through `Writer`, which is all `Test` stands for. Effects listed in front of
 * it are what the cases may additionally perform.
 */
type Test = {Writer[List[TestResult]]} Unit

/**
 * Name a test case. It becomes a test once `in` gives it a body.
 */
infix none def should(subject: String, shouldPhrase: String): TestCase =
   TestCase(subject, shouldPhrase)

/**
 * Run `body` right here and add its result to the enclosing suite.
 *
 * A failed assertion stops this body only: its error becomes this case's `FailedWith` outcome, and the next case
 * still runs. Any other effect the body performs must be allowed by the suite's return type, or supplied by a
 * word such as `mocked`.
 */
infix none below should
def in(testCase: TestCase, body: {Throw[AssertionError]} Unit): Test =
   tell(singleton(TestResult(testCase, outcomeOf(runThrow(body)))))

private def outcomeOf(raised: Either[AssertionError, Unit]): Outcome = raised.foldEither(error -> FailedWith(error), _ -> Passed)
