import eliot.carrier.Effect
import eliot.collection.List
import eliot.test.Assertion

/**
 * What a test case is *about*: the `subject` under test and the `should` phrase naming the expectation. It carries no
 * body — a case's body is run by `in`, on the suite's own carrier, so what the framework ever holds is the case's name
 * and what running it answered.
 */
data TestCase(subject: String, shouldPhrase: String)

/**
 * A test case together with the verdict of running it. Plain data throughout: nothing here is a suspended computation,
 * so the type commits to no carrier and the runner has nothing left to discharge.
 */
data TestResult(testCase: TestCase, outcome: Outcome)

/**
 * What running one test body answered: the `AssertionError` it raised, or `unit` when it raised nothing.
 */
type Outcome = Either[AssertionError, Unit]

/**
 * Name a test case: the `subject` under test and the `should` phrase naming the expectation. The case is not complete
 * until `in` gives it a body.
 */
infix none def should(subject: String, shouldPhrase: String): TestCase =
   TestCase(subject, shouldPhrase)

/**
 * Run a named case's body and register its verdict into the enclosing suite.
 *
 * `in` discharges the **assertion** effect and is transparent to every other effect the body performs: the body's row
 * is pinned only at `Throw[AssertionError]`, over the suite's own carrier `G`, so what a test may do is decided by the
 * suite's declared row and by nothing here. A suite declaring `{Writer[List[TestResult]]}` alone admits only bodies
 * that assert; one that also declares `{Console}` admits bodies that print, on whatever carrier the runner is compiled
 * to. Wrap a body in `pure` to forbid all effects regardless of what the suite allows.
 *
 * Because the body is a *slot* rather than stored data, it is written where it stands — no test is collected unrun.
 */
infix none below should
def in[G[_] ~ Writer[List[TestResult]] & Effect](testCase: TestCase, body: {Throw[AssertionError] | G} Unit): G[Unit] = {
   val outcome = runThrow(body)

   tell(singleton(TestResult(testCase, outcome)))
}

/**
 * Register an already-computed verdict as this case's body: `"…" should "…" in verdict(farewellOutcome)`.
 *
 * The counterpart of `pure` for a case discharged by the test author's *own* word — a fake-carrier run answers an
 * `Outcome` as plain data, and this is what stands it where a body stands, so `in` cannot tell the two apart. It is a
 * framework word rather than a bare `orRaise` so that the three ways to give a case a body read alike: the suite's own
 * row inline, `pure { … }`, and `verdict(…)`.
 */
def verdict(outcome: Outcome): {Throw[AssertionError]} Unit = orRaise(outcome)
