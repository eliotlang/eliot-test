import eliot.lang.Id
import eliot.collection.List
import eliot.test.Assertion

/**
 * What a test case is *about*: the `subject` under test and the `should` phrase naming the expectation. It carries no
 * body — a case's body is run where it is written, by the discharge word standing between `in` and the block, so what
 * the framework ever holds is the case's name and what running it answered.
 */
data TestCase(subject: String, shouldPhrase: String)

/**
 * A test case together with the verdict of running it. Plain data throughout: nothing here is a suspended computation,
 * so the type commits to no carrier and the runner has nothing left to discharge.
 */
data TestResult(testCase: TestCase, outcome: Outcome)

/**
 * What running one test body answered: the `AssertionError` it raised, or `unit` when it raised nothing.
 *
 * This is the type every discharge word answers — `pure` for a body that may only assert, an author's own word for a
 * body running on a carrier of their own. Which effects a body was allowed to perform is decided by the word's
 * parameter type; by the time `in` sees the case, all that is left is the verdict.
 */
type Outcome = Either[AssertionError, Unit]

/**
 * A suite: a `Writer` computation accumulating a `List[TestResult]` log, and the type compile-time reflection gathers.
 *
 * It is a `Writer` because a suite only ever *appends* cases and never reads back what has been registered — the honest
 * contract for a collector (`Writer` = append-only `State`; the log's monoid is `Combine[List]` = concatenation). It is
 * pinned to `Id` because a stored, gathered type must be concrete — and because that pin is the suite's own guarantee:
 * `Id` has no `Suspend`, so a suite can perform nothing but its own registration.
 */
type Test = {Writer[List[TestResult]] | Id} Unit

/**
 * Name a test case: the `subject` under test and the `should` phrase naming the expectation. The case is not complete
 * until `in` gives it an outcome.
 */
infix none def should(subject: String, shouldPhrase: String): TestCase =
   TestCase(subject, shouldPhrase)

/**
 * Register a named case's outcome into the enclosing suite.
 *
 * `in` takes an `Outcome` — plain data — so it names no effect and no carrier. The word between `in` and the block is
 * what runs the body and constrains what the body was allowed to do: `"…" should "…" in pure { … }` for a unit test.
 * Because the outcome is an argument, the body has already run by the time the case is registered.
 *
 * The pinned row is spelled out rather than written as `Test`: a closed-row alias is not yet carried in both a
 * definition's return position and a reflected value's, so the spelled-out form is the one that compiles either way.
 */
infix none below should def in(testCase: TestCase, outcome: Outcome): {Writer[List[TestResult]] | Id} Unit =
   tell(singleton(TestResult(testCase, outcome)))
