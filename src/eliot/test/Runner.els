import eliot.lang.Id
import eliot.compiler.Reflect
import eliot.test.Test
import eliot.test.Assertion
import eliot.collection.List

/**
 * Runs every test case declared anywhere in the program under the name `testCases`, printing one line per
 * subject with its pass and failure counts, each failure detailed underneath. Point the compiler at the source
 * roots and run this module's `main` to execute the whole suite.
 */
def main: {Console} Unit =
   namedValues[Test]("testCases").foreach(runSuite)

/**
 * Runs one module's suite: its collected test cases gathered by subject, subjects in order of first mention.
 */
private def runSuite(suite: Test): {Console} Unit =
   runId(runWriterToLog(suite))
     .groupBy(subject)
     .foreach(runSubject)

/**
 * Runs every case of one subject and reports them as a single line: the subject, how many of its cases passed
 * and — only when there were any — how many failed, with each failure's detail lines following underneath.
 */
private def runSubject(group: Pair[String, List[TestCase]]): {Console} Unit =
   group
      .foldPair(subjectName -> cases -> report(subjectName, cases.map(runTestCase)))
      .foreach(printLine)

/**
 * One subject's report lines, built from its cases' failure lines: a case passed exactly when its lines are
 * empty, so the header's counts and the detail body underneath both come from the same list.
 */
private def report(subjectName: String, failures: List[List[String]]): List[String] = {
   val failedCount = failures.filter(lines -> fold(lines.isEmpty, false, true)).size

   prepend(failures.flatten, header(subjectName, failures.size - failedCount, failedCount))
}

/**
 * A subject's headline: green with just the pass count while everything passed, red and naming both counts as
 * soon as anything did not.
 */
private def header(subjectName: String, passedCount: Int, failedCount: Int): String =
   fold(
      failedCount == 0,
      " ✔ ".ansiSuccess ++ subjectName.ansiHighlight ++ (" · " ++ show(passedCount) ++ " passed").ansiNote,
      " ✗ ".ansiFail ++ subjectName.ansiHighlight ++ (" · " ++ show(passedCount) ++ " passed, ").ansiNote ++
         (show(failedCount) ++ " failed").ansiFail
   )

/**
 * Runs a single test case: discharges its `Throw` on the pure `Id` carrier to an `Either`, and answers the lines
 * reporting its failure — its `should` phrase and the failure's detail lines — or no lines at all when it passed.
 */
private def runTestCase(testCase: TestCase): List[String] =
   runId(runThrow(testCase.body))
      .foldEither(
         e -> prepend(e.describe.map(line -> " |   ".ansiFail ++ line), " | ✗ ".ansiFail ++ testCase.shouldPhrase.ansiHighlight),
         _ -> empty
      )

/**
 * Renders a failure shape into presentation lines — the one place deciding how each `AssertionError`
 * constructor reads in the report.
 */
private def describe(error: AssertionError): List[String] = error match {
   case Failed(reason)             -> append(empty, reason.ansiFail)
   case NotEqual(expected, actual) -> append(append(empty, "expected ".ansiNote ++ expected.ansiSuccess), "actual   ".ansiNote ++ actual.ansiFail)
   case UnexpectedlyEqual(equal)   -> append(empty, "expected a value different from ".ansiNote ++ equal.ansiFail)
   case NoErrorRaised(expected)    -> append(append(empty, "expected error ".ansiNote ++ expected.ansiSuccess), "but no error was raised".ansiFail)
}

private def ansiFail(str: String): String = "\u001B[1;31m" ++ str ++ "\u001B[0m"

private def ansiSuccess(str: String): String = "\u001B[1;32m" ++ str ++ "\u001B[0m"

private def ansiHighlight(str: String): String = "\u001B[1;37m" ++ str ++ "\u001B[0m"

private def ansiNote(str: String): String = "\u001B[2;37m" ++ str ++ "\u001B[0m"
