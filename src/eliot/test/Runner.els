import eliot.lang.Id
import eliot.compiler.Reflect
import eliot.test.Test
import eliot.test.Assertion
import eliot.collection.List

/**
 * Runs every test case declared anywhere in the program under the name `testCases`, printing each test's name
 * followed by `PASS` or the failure message. Point the compiler at the source roots and run this module's
 * `main` to execute the whole suite.
 */
def main: {Console} Unit =
   namedValues[Test]("testCases").foreach(runSuite)

/**
 * Runs one module's suite: each collected test case in declaration order.
 */
private def runSuite(suite: Test): {Console} Unit =
   runId(runWriterToLog(suite))
     .foreach(runTestCase)

/**
 * Runs a single test case: discharges its `Throw` on the pure `Id` carrier to an `Either`, then reports the name
 * and outcome — a failure's detail lines indented under its header.
 */
private def runTestCase(testCase: TestCase): {Console} Unit = {
   val outcome = runId(runThrow(testCase.body))

   outcome.foldEither(
      e -> {
         printLine(" | ✗ ".ansiFail ++ testCase.subject.ansiFail ++ " › ".ansiNote ++ testCase.shouldPhrase.ansiHighlight)
         e.describe.foreach(line -> printLine(" |   ".ansiFail ++ line))
      },
      _ -> printLine(" ✔ ".ansiSuccess ++ testCase.subject.ansiHighlight ++ " · 1 passed".ansiNote)
   )
}

/**
 * Renders a failure shape into presentation lines — the one place deciding how each `AssertionError`
 * constructor reads in the report.
 */
private def describe(error: AssertionError): List[String] = error match {
   case Failed(reason)             -> append(empty, reason.ansiFail)
   case NotEqual(expected, actual) -> append(append(empty, "expected ".ansiNote ++ expected.ansiSuccess), "actual   ".ansiNote ++ actual.ansiFail)
   case UnexpectedlyEqual(equal)   -> append(empty, "expected a value different from ".ansiNote ++ equal.ansiFail)
   case NoErrorRaised(expected)    -> append(append(empty, "expected error ".ansiNote ++ expected.ansiSuccess), "but no error was raised".ansiFail)
}

private def ansiFail(str: String): String = "\u001B[1;31m" ++ str ++ "\u001B[0m"

private def ansiSuccess(str: String): String = "\u001B[1;32m" ++ str ++ "\u001B[0m"

private def ansiHighlight(str: String): String = "\u001B[1;37m" ++ str ++ "\u001B[0m"

private def ansiNote(str: String): String = "\u001B[2;37m" ++ str ++ "\u001B[0m"
