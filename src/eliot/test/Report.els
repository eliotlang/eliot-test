import eliot.collection.List
import eliot.test.Test
import eliot.test.Assertion

/**
 * How the report is printed: with ANSI colours for a terminal, `Plain` text for logs and for anyone who set
 * `NO_COLOR`, or as `Teamcity` service messages, the line-based protocol an IDE's test runner reads to build its results
 * tree (`##teamcity[testStarted name='…']`). `Teamcity` is for a program to read, not a person: it carries no colour and
 * leaves the closing summary as plain text.
 */
data Style = Colored | Plain | Teamcity

/**
 * How many cases passed and how many failed.
 */
data Tally(passedCount: Int, failedCount: Int)

/**
 * Count the passed and failed cases among `results`.
 */
def tally(results: List[TestResult]): Tally =
   Tally(results.filter(passed).size, results.filter(result -> !(passed(result))).size)

/**
 * Whether nothing failed.
 */
def allPassed(counts: Tally): Bool = counts.failedCount == 0

/**
 * The report of one suite: its module's name, then one line per subject with each failure detailed underneath.
 *
 * ```
 * eliot.test.example.GreeterTests
 *  ✔ greeting · 2 passed
 *  ✗ greet · 1 passed, 1 failed
 *  | ✗ fall back to a stranger on no input
 *  |   expected Hello, stranger!
 *  |   actual   Hello, !
 * ```
 *
 * `suiteName` is the qualified name the runner gathered the suite under, `eliot.test.example.GreeterTests::testCases`;
 * subjects are listed in the order they first appear.
 *
 * In the `Teamcity` style it is the same structure as service messages instead — the module is a test suite, each
 * subject a suite inside it and each case a test, named by its `should` phrase:
 *
 * ```
 * ##teamcity[testSuiteStarted name='eliot.test.example.GreeterTests']
 * ##teamcity[testSuiteStarted name='greet']
 * ##teamcity[testStarted name='fall back to a stranger on no input']
 * ##teamcity[testFailed name='fall back to a stranger on no input' message='expected Hello, stranger! but was Hello, !' details='expected Hello, stranger!|nactual   Hello, !' expected='Hello, stranger!' actual='Hello, !']
 * ##teamcity[testFinished name='fall back to a stranger on no input']
 * ##teamcity[testSuiteFinished name='greet']
 * ##teamcity[testSuiteFinished name='eliot.test.example.GreeterTests']
 * ```
 *
 * A failed `NotEqual` carries its `expected` and `actual` as attributes, which is what lets an IDE offer a comparison.
 */
def suiteReport(style: Style, suiteName: String, results: List[TestResult]): List[String] = style match {
   case Teamcity -> teamcityReport(suiteName, results)
   case Colored  -> textReport(style, suiteName, results)
   case Plain    -> textReport(style, suiteName, results)
}

/**
 * The closing line of the whole run, worth reading when the report scrolled past: "all clear" while every case
 * passed, an inverted red band naming the failures as soon as any did not.
 */
def summary(style: Style, counts: Tally): String =
   if(counts.allPassed) {
      (" ✔ all clear · " ++ show(counts.passedCount) ++ " passed ").inGreen(style)
   } else {
      (" ✗ " ++ show(counts.failedCount) ++ " failed · " ++ show(counts.passedCount) ++ " passed ").alarming(style)
   }

private def subjectOf(result: TestResult): String = result.testCase.subject

private def textReport(style: Style, suiteName: String, results: List[TestResult]): List[String] =
   prepend(
      results.groupBy(subjectOf).flatMap(group -> subjectReport(style, group.first, group.second)),
      suiteName.before("::").dimmed(style)
   )

/**
 * One suite as service messages: the module opens and closes a suite around one suite per subject.
 */
private def teamcityReport(suiteName: String, results: List[TestResult]): List[String] = {
   val moduleName = suiteName.before("::")
   val subjects = results.groupBy(subjectOf).flatMap(group -> teamcitySubject(group.first, group.second))

   prepend(append(subjects, serviceMessage("testSuiteFinished", moduleName, "")), serviceMessage("testSuiteStarted", moduleName, ""))
}

private def teamcitySubject(subject: String, results: List[TestResult]): List[String] =
   prepend(
      append(results.flatMap(teamcityCase), serviceMessage("testSuiteFinished", subject, "")),
      serviceMessage("testSuiteStarted", subject, "")
   )

/**
 * One case: started, its failure if it failed, finished. A failed case is still finished, which is how the protocol
 * says the test ran and did not pass.
 */
private def teamcityCase(result: TestResult): List[String] = {
   val name = result.testCase.shouldPhrase

   prepend(
      append(teamcityFailure(name, result.outcome), serviceMessage("testFinished", name, "")),
      serviceMessage("testStarted", name, "")
   )
}

private def teamcityFailure(name: String, outcome: Outcome): List[String] = outcome match {
   case Passed            -> empty
   case FailedWith(error) -> singleton(
      serviceMessage(
         "testFailed",
         name,
         attribute("message", failureMessage(error)) ++ attribute("details", describe(Plain, error).joined("\n")) ++ comparison(error)
      )
   )
}

/**
 * The one line saying what went wrong, for the place an IDE shows a failure in a single row.
 */
private def failureMessage(error: AssertionError): String = error match {
   case Failed(reason)             -> reason
   case NotEqual(expected, actual) -> "expected " ++ expected ++ " but was " ++ actual
   case UnexpectedlyEqual(equal)   -> "expected a value different from " ++ equal
   case NoErrorRaised(expected)    -> "expected error " ++ expected ++ " but no error was raised"
   case Described(message, cause)  -> message
}

/**
 * The `expected` and `actual` attributes of a comparison, which an IDE turns into a diff; nothing for a failure that is
 * not one.
 */
private def comparison(error: AssertionError): String = error match {
   case NotEqual(expected, actual) -> attribute("expected", expected) ++ attribute("actual", actual)
   case Failed(_)                  -> ""
   case UnexpectedlyEqual(_)       -> ""
   case NoErrorRaised(_)           -> ""
   case Described(_, _)            -> ""
}

/**
 * `##teamcity[kind name='name' attributes]`, `attributes` being already-rendered ` key='value'` pairs.
 */
private def serviceMessage(kind: String, name: String, attributes: String): String =
   "##teamcity[" ++ kind ++ attribute("name", name) ++ attributes ++ "]"

private def attribute(key: String, value: String): String = " " ++ key ++ "='" ++ escaped(value) ++ "'"

/**
 * `text` escaped for a service message's quoted value: the escape character itself first, then the characters the
 * protocol reserves.
 */
private def escaped(text: String): String =
   text.replace("|", "||").replace("'", "|'").replace("\n", "|n").replace("\r", "|r").replace("[", "|[").replace("]", "|]")

/**
 * One subject's line, followed by the details of each failed case.
 */
private def subjectReport(style: Style, subject: String, results: List[TestResult]): List[String] =
   prepend(results.flatMap(result -> failureLines(style, result)), header(style, subject, tally(results)))

private def header(style: Style, subject: String, counts: Tally): String =
   if(counts.allPassed) {
      " ✔ ".inGreen(style) ++ subject.bold(style) ++ (" · " ++ show(counts.passedCount) ++ " passed").dimmed(style)
   } else {
      " ✗ ".inRed(style) ++ subject.bold(style) ++ (" · " ++ show(counts.passedCount) ++ " passed, ").dimmed(style) ++
         (show(counts.failedCount) ++ " failed").inRed(style)
   }

/**
 * A failed case's `should` phrase and what went wrong; nothing for a case that passed.
 */
private def failureLines(style: Style, result: TestResult): List[String] = result.outcome match {
   case Passed            -> empty
   case FailedWith(error) -> {
      val title = " | ✗ ".inRed(style) ++ result.testCase.shouldPhrase.bold(style)
      val details = describe(style, error).map(line -> " |   ".inRed(style) ++ line)

      prepend(details, title)
   }
}

/**
 * How each kind of `AssertionError` reads in the report.
 */
private def describe(style: Style, error: AssertionError): List[String] = error match {
   case Failed(reason) ->
      singleton(reason.inRed(style))
   case NotEqual(expected, actual) ->
      append(singleton("expected ".dimmed(style) ++ expected.inGreen(style)), "actual   ".dimmed(style) ++ actual.inRed(style))
   case UnexpectedlyEqual(equal) ->
      singleton("expected a value different from ".dimmed(style) ++ equal.inRed(style))
   case NoErrorRaised(expected) ->
      append(singleton("expected error ".dimmed(style) ++ expected.inGreen(style)), "but no error was raised".inRed(style))
   case Described(message, cause) ->
      append(singleton(message.inRed(style)), "because ".dimmed(style) ++ cause)
}

private def inRed(style: Style, text: String): String = text.painted(style, "1;31")

private def inGreen(style: Style, text: String): String = text.painted(style, "1;32")

private def bold(style: Style, text: String): String = text.painted(style, "1;37")

private def dimmed(style: Style, text: String): String = text.painted(style, "2;37")

/**
 * White on red: the summary of a failed run, so it stands out from the red failure details above it.
 */
private def alarming(style: Style, text: String): String = text.painted(style, "1;37;41")

/**
 * `text` wrapped in the ANSI escape sequence selecting `code` and reset after it, or `text` itself when `Plain` or `Teamcity`.
 */
private def painted(style: Style, code: String, text: String): String = style match {
   case Colored  -> "\u001B[" ++ code ++ "m" ++ text ++ "\u001B[0m"
   case Plain    -> text
   case Teamcity -> text
}
