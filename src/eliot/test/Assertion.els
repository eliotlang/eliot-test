/**
 * The error a failing assertion raises. Each constructor is a kind of failure, carrying the values involved
 * already rendered as text; the runner decides how each kind is printed.
 *
 * - `Failed(reason)` — a failure explained in words, as raised by `fail`.
 * - `NotEqual(expectedValue, actualValue)` — two values differed, as raised by `shouldBe`.
 * - `UnexpectedlyEqual(equalValue)` — two values were the same, as raised by `shouldNotBe`.
 * - `NoErrorRaised(expectedError)` — a body was expected to raise and did not, as raised by `expect`.
 * - `Described(description, originalFailure)` — any of the above under a description of the test's own, as raised by `describedAs`.
 */
data AssertionError = Failed(reason: String) |
   NotEqual(expectedValue: String, actualValue: String) |
   UnexpectedlyEqual(equalValue: String) |
   NoErrorRaised(expectedError: String) |
   Described(description: String, originalFailure: String)

/**
 * Two assertion errors are equal when they are the same kind of failure carrying the same values, which is what
 * lets `expect` check for one specific failure.
 */
implement Eq[AssertionError] {
   def equals(a: AssertionError, b: AssertionError): Bool = a match {
      case Failed(reason) -> b match {
         case Failed(otherReason) -> reason == otherReason
         case _                   -> false
      }
      case NotEqual(expected, actual) -> b match {
         case NotEqual(otherExpected, otherActual) -> expected == otherExpected && actual == otherActual
         case _                                    -> false
      }
      case UnexpectedlyEqual(value) -> b match {
         case UnexpectedlyEqual(otherValue) -> value == otherValue
         case _                             -> false
      }
      case NoErrorRaised(expected) -> b match {
         case NoErrorRaised(otherExpected) -> expected == otherExpected
         case _                            -> false
      }
      case Described(message, cause) -> b match {
         case Described(otherMessage, otherCause) -> message == otherMessage && cause == otherCause
         case _                                   -> false
      }
   }
}

/**
 * A one-line rendering naming the kind of failure and its values, such as `NotEqual(expected: a, actual: b)`.
 */
implement Show[AssertionError] {
   def show(value: AssertionError): String = value match {
      case Failed(reason)             -> "Failed(" ++ reason ++ ")"
      case NotEqual(expected, actual) -> "NotEqual(expected: " ++ expected ++ ", actual: " ++ actual ++ ")"
      case UnexpectedlyEqual(equal)   -> "UnexpectedlyEqual(" ++ equal ++ ")"
      case NoErrorRaised(expected)    -> "NoErrorRaised(" ++ expected ++ ")"
      case Described(message, cause)  -> "Described(" ++ message ++ ", cause: " ++ cause ++ ")"
   }
}

/**
 * A test body that passes without asserting anything.
 */
def success: {Throw[AssertionError]} Unit = unit

/**
 * Fail the test with the given `reason`.
 */
def fail(reason: String): {Throw[AssertionError]} Unit = raise(Failed(reason))

/**
 * Assert that `actual` equals `expected`, failing with `NotEqual` otherwise: `greeting("Bob") shouldBe "Hello, Bob!"`.
 */
infix def shouldBe[A ~ Eq & Show](actual: A, expected: A): {Throw[AssertionError]} Unit =
   unless(actual == expected) raise(NotEqual(show(expected), show(actual)))

/**
 * Assert that `actual` differs from `unexpected`, failing with `UnexpectedlyEqual` otherwise.
 */
infix at shouldBe def shouldNotBe[A ~ Eq & Show](actual: A, unexpected: A): {Throw[AssertionError]} Unit =
   when(actual == unexpected) raise(UnexpectedlyEqual(show(actual)))

/**
 * Assert that `actual` is `true`: `exists(path("/tmp/x")).shouldBeTrue`. (`shouldBe true` does not compile,
 * because `Bool` has no `Show`.)
 */
def shouldBeTrue(actual: Bool): {Throw[AssertionError]} Unit =
   unless(actual) fail("expected true, but was false")

/**
 * Assert that `actual` is `false`: `isDirectory(path("/tmp/x")).shouldBeFalse`.
 */
def shouldBeFalse(actual: Bool): {Throw[AssertionError]} Unit =
   when(actual) fail("expected false, but was true")

/**
 * Give a failing assertion a message of the test's own. The original failure is kept as the cause, so the report
 * still shows what was expected and what was found:
 *
 * ```eliot
 * config.port shouldBe 8080 describedAs "the default port"
 * // fails with Described("the default port", "NotEqual(expected: 8080, actual: 80)")
 * ```
 *
 * A passing body passes unchanged.
 */
infix left below shouldBe def describedAs(body: {Throw[AssertionError]} Unit, newMessage: String): {Throw[AssertionError]} Unit =
   catch[AssertionError, Unit](body, cause -> raise(Described(newMessage, show(cause))))

/**
 * Assert that `body` raises exactly `error`: `expect(NotEqual("a", "b"), "b" shouldBe "a")`.
 *
 * Fails with `NotEqual` when the body raises a different error, and with `NoErrorRaised` when it raises nothing.
 * `raising` is the same check comparing only part of the error's text.
 */
def expect[E ~ Eq & Show](error: E, body: {Throw[E]} Unit): {Throw[AssertionError]} Unit =
   runThrow(body).foldEither(raised -> raised shouldBe error, _ -> raise(NoErrorRaised(show(error))))

/**
 * Assert that `body` raises an error whose text contains `expectedReport`:
 *
 * ```eliot
 * raising[GitError]("exit code 128", fetch(mirror))
 * ```
 *
 * Use it when the exact error is beside the point and a recognisable part of its message is enough; `expect` is
 * the same check comparing the whole error. The error type is written out when the body alone does not say which
 * one it raises, as above.
 */
def raising[E ~ Show](expectedReport: String, body: {Throw[E]} Unit): {Throw[AssertionError]} Unit =
   runThrow[E, Unit](body).foldEither(
      raised -> reportContaining(expectedReport, show(raised)),
      _ -> fail("expected a raise reporting '" ++ expectedReport ++ "', but nothing was raised")
   )

private def reportContaining(expectedReport: String, report: String): {Throw[AssertionError]} Unit =
   unless(contains(expectedReport, report)) fail(
      "expected a raise reporting '" ++ expectedReport ++ "', but got '" ++ report ++ "'"
   )
