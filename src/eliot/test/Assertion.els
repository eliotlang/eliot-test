import eliot.lang.Id

/**
 * The error raised by a failing assertion: a semantic failure shape carrying the already-rendered values
 * involved. Assertions render values to `String` at the raise site (where the `Show` instance is known);
 * choosing how a shape is *presented* — labels, layout, color — is the runner's job.
 *
 * The constructors are failure shapes, not one per assertion: new assertions mostly reuse `NotEqual` and
 * `Failed` rather than adding shapes.
 */
data AssertionError = Failed(reason: String) |
   NotEqual(expectedValue: String, actualValue: String) |
   UnexpectedlyEqual(equalValue: String) |
   NoErrorRaised(expectedError: String)

/**
 * Two assertion errors are equal when they are the same failure shape carrying the same rendered values.
 * Being structural — rather than comparing rendered messages — lets `expect` check for a specific failure
 * without coupling tests to presentation.
 */
implement Eq[AssertionError] {
   def equals(a: AssertionError, b: AssertionError): Bool = a match {
      case Failed(reason) -> b match {
         case Failed(otherReason) -> reason == otherReason
         case _                   -> false
      }
      case NotEqual(expected, actual) -> b match {
         case NotEqual(otherExpected, otherActual) -> expected == otherExpected && actual == otherActual
         case _                                    -> false
      }
      case UnexpectedlyEqual(value) -> b match {
         case UnexpectedlyEqual(otherValue) -> value == otherValue
         case _                             -> false
      }
      case NoErrorRaised(expected) -> b match {
         case NoErrorRaised(otherExpected) -> expected == otherExpected
         case _                            -> false
      }
   }
}

/**
 * A compact single-line debug rendering of the failure shape, used when an assertion error is itself a
 * compared value (as in `expect`'s mismatch report). The runner's multi-line presentation is separate.
 */
implement Show[AssertionError] {
   def show(value: AssertionError): String = value match {
      case Failed(reason)             -> "Failed(" ++ reason ++ ")"
      case NotEqual(expected, actual) -> "NotEqual(" ++ expected ++ ", " ++ actual ++ ")"
      case UnexpectedlyEqual(equal)   -> "UnexpectedlyEqual(" ++ equal ++ ")"
      case NoErrorRaised(expected)    -> "NoErrorRaised(" ++ expected ++ ")"
   }
}

/**
 * Run a test body on the pure identity carrier, answering what it raised — the framework's own discharge word, and the
 * one place in it that names a carrier.
 *
 * `Id` has no `Suspend` instance, so a body handed to `pure` may assert and do nothing else: a `printLine` in a unit
 * test is a compile error, not a test that quietly performs I/O. That constraint is the word's whole meaning; running
 * the body down to a plain verdict is the consequence.
 *
 * A test author writes their own word the same way, with their own carrier in the body's row, and `in` consumes either
 * without knowing the difference. Note that a fake carrier's *run* must sit in a definition of its own rather than
 * inside a pinned body — a region writes every carrier-generic callee at its own carrier — so testing effectful code
 * is run-then-assert: run the production code under the fake in a plain `def`, assert on the value it answers here.
 */
def pure[E, A](body: {Throw[E] | Id} A): Either[E, A] = runId(runThrow(body))

/**
 * A trivially passing test body: it makes no assertion, so it never raises.
 */
def success: {Throw[AssertionError]} Unit = unit

/**
 * Fail the current test unconditionally with the given `reason`.
 */
def fail(reason: String): {Throw[AssertionError]} Unit = raise(Failed(reason))

/**
 * Expect the given `error` to be raised by `body`: passes when the raised error equals `error`, raises
 * `NotEqual` when the body raises a different error and `NoErrorRaised` when it completes without raising.
 */
def expect[E ~ Eq & Show](error: E, body: {Throw[E] | Id} Unit): {Throw[AssertionError]} Unit =
   pure(body)
      .foldEither(raised -> raised shouldBe error, _ -> raise(NoErrorRaised(show(error))))

/**
 * Assert that `expected` and `actual` are equal (by their `Eq` instance), raising `NotEqual` with both
 * rendered values otherwise.
 */
infix def shouldBe[A ~ Eq & Show](actual: A, expected: A): {Throw[AssertionError]} Unit =
   if(actual == expected) unit else raise(NotEqual(show(expected), show(actual)))

/**
 * Assert that `actual` differs from `unexpected` (by their `Eq` instance), raising `UnexpectedlyEqual` with
 * the rendered value both sides turned out to be otherwise.
 */
infix at shouldBe def shouldNotBe[A ~ Eq & Show](actual: A, unexpected: A): {Throw[AssertionError]} Unit =
   if(actual != unexpected) unit else raise(UnexpectedlyEqual(show(actual)))

/**
 * Rewrite the failure message: runs `body` and, when it raises any `AssertionError`, re-raises it as a
 * `Failed` carrying `newMessage`. A passing body is left untouched.
 */
infix left below shouldBe def message(body: {Throw[AssertionError] | Id} Unit, newMessage: String): {Throw[AssertionError]} Unit =
   pure(body)
      .foldEither(_ -> fail(newMessage), _ -> success)
