import eliot.collection.List
import eliot.file.Path
import eliot.file.File
import eliot.test.Assertion
import eliot.test.Test
import eliot.test.Mock

/**
 * The file system double: an in-memory tree of what a test arranged plus whatever the code under test wrote,
 * every operation recording the call it was asked.
 */
def testCases: Test = {
   "readFile" should "answer what the test arranged" in mocked {
      withFile(path("/etc/hosts"), "127.0.0.1 localhost")

      readFile(path("/etc/hosts")) shouldBe "127.0.0.1 localhost"
   }
   "readFile" should "answer empty for a file nobody arranged" in mocked {
      readFile(path("/nowhere")) shouldBe ""
   }
   "readFile" should "record the call" in mocked {
      readFile(path("/etc/hosts"))

      calls shouldBe "readFile /etc/hosts"
   }
   "writeFile" should "make the content readable afterwards" in mocked {
      writeFile("written", path("/tmp/out"))

      readFile(path("/tmp/out")) shouldBe "written"
   }
   "writeFile" should "make the file exist" in mocked {
      writeFile("written", path("/tmp/out"))

      exists(path("/tmp/out")).shouldBeTrue
   }
   "appendFile" should "add to what is already there" in mocked {
      withFile(path("/tmp/log"), "first\n")
      appendFile("second", path("/tmp/log"))

      readFile(path("/tmp/log")) shouldBe "first\nsecond"
   }
   "readLines" should "split the arranged content into its lines" in mocked {
      withFile(path("/tmp/three"), "a\nb\nc")

      readLines(path("/tmp/three")).joined(",") shouldBe "a,b,c"
   }
   "readLines" should "end the last line at a final line ending rather than start an empty one" in mocked {
      withFile(path("/tmp/ended"), "a\nb\n")

      readLines(path("/tmp/ended")).joined(",") shouldBe "a,b"
   }
   "readLines" should "read a lone line ending as one empty line" in mocked {
      withFile(path("/tmp/blank"), "\n")

      readLines(path("/tmp/blank")).size shouldBe 1
   }
   "readLines" should "keep an empty line in the middle" in mocked {
      withFile(path("/tmp/gap"), "a\n\nb")

      readLines(path("/tmp/gap")).joined(",") shouldBe "a,,b"
   }
   "readLines" should "end a line at CR LF and at a lone CR, as well as at LF" in mocked {
      withFile(path("/tmp/windows"), "a\r\nb\rc\r\n")

      readLines(path("/tmp/windows")).joined(",") shouldBe "a,b,c"
   }
   "readLines" should "answer nothing for an empty file" in mocked {
      withFile(path("/tmp/empty"), "")

      readLines(path("/tmp/empty")).size shouldBe 0
   }
   "foldLines" should "fold over the lines, front to back" in mocked {
      withFile(path("/tmp/three"), "a\nb\nc")

      foldLines("", acc -> line -> acc ++ line, path("/tmp/three")) shouldBe "abc"
   }
   "foldLines" should "see the lines readLines sees" in mocked {
      withFile(path("/tmp/ended"), "a\r\nb\n")

      foldLines("", acc -> line -> acc ++ "[" ++ line ++ "]", path("/tmp/ended")) shouldBe "[a][b]"
   }
   "foldCodePoints" should "fail the case, naming the call, rather than answer as if it had folded" in {
      (refusalFailures.at(0) orElse "<none>") shouldBe "Failed(foldCodePoints /tmp/three: the mocked FileSystem cannot fold a file's code points)"
   }
   "exists" should "be true for an arranged file and false for anything else" in mocked {
      withFile(path("/tmp/there"), "x")

      exists(path("/tmp/there")).shouldBeTrue
      exists(path("/tmp/elsewhere")).shouldBeFalse
   }
   "exists" should "be true for an arranged directory" in mocked {
      withDirectory(path("/tmp/dir"))

      exists(path("/tmp/dir")).shouldBeTrue
   }
   "isDirectory" should "tell a directory from a file" in mocked {
      withDirectory(path("/tmp/dir"))
      withFile(path("/tmp/file"), "x")

      isDirectory(path("/tmp/dir")).shouldBeTrue
      isDirectory(path("/tmp/file")).shouldBeFalse
   }
   "listDirectory" should "answer the immediate entries, a subdirectory once, and not what is deeper" in mocked {
      withFile(path("/tmp/dir/one"), "1")
      withFile(path("/tmp/dir/two"), "2")
      withFile(path("/tmp/dir/nested/three"), "3")
      withFile(path("/tmp/dir/nested/four"), "4")

      listDirectory(path("/tmp/dir")).map(show).sorted.joined(",") shouldBe "/tmp/dir/nested,/tmp/dir/one,/tmp/dir/two"
   }
   "walk" should "answer every file underneath, however deep, and no directory" in mocked {
      withFile(path("/tmp/dir/one"), "1")
      withFile(path("/tmp/dir/nested/three"), "3")
      withDirectory(path("/tmp/dir/empty"))

      walk(path("/tmp/dir")).map(show).sorted.joined(",") shouldBe "/tmp/dir/nested/three,/tmp/dir/one"
   }
   "a directory" should "exist when a file was put inside it, even if nobody created it" in mocked {
      withFile(path("/tmp/dir/nested/three"), "3")

      exists(path("/tmp/dir")).shouldBeTrue
      isDirectory(path("/tmp/dir/nested")).shouldBeTrue
      isDirectory(path("/tmp/dir/nested/three")).shouldBeFalse
   }
   "a directory" should "be the same directory with or without a trailing slash" in mocked {
      withDirectory(path("/tmp/dir/"))

      isDirectory(path("/tmp/dir")).shouldBeTrue
   }
   "a path" should "not count as inside a sibling that merely starts with the same letters" in mocked {
      withFile(path("/tmp/directory/one"), "1")

      exists(path("/tmp/dir")).shouldBeFalse
   }
   "createDirectories" should "make the directory exist" in mocked {
      createDirectories(path("/tmp/made"))

      isDirectory(path("/tmp/made")).shouldBeTrue
   }
   "delete" should "remove what was there" in mocked {
      withFile(path("/tmp/doomed"), "x")
      delete(path("/tmp/doomed"))

      exists(path("/tmp/doomed")).shouldBeFalse
   }
   "delete" should "remove an empty directory" in mocked {
      withDirectory(path("/tmp/dir"))
      delete(path("/tmp/dir"))

      exists(path("/tmp/dir")).shouldBeFalse
   }
   "delete" should "leave what is beside the deleted path" in mocked {
      withFile(path("/tmp/dir/one"), "1")
      withFile(path("/tmp/dir/two"), "2")
      delete(path("/tmp/dir/one"))

      exists(path("/tmp/dir/two")).shouldBeTrue
   }
   "delete" should "fail the case for a directory with something inside it, as the platform refuses it" in {
      (refusalFailures.at(1) orElse "<none>") shouldBe "Failed(delete /tmp/dir: the directory is not empty; the platform raises an IoError here)"
   }
   "delete" should "fail the case for a path nothing is at, as the platform refuses it" in {
      (refusalFailures.at(2) orElse "<none>") shouldBe "Failed(delete /tmp/nowhere: there is nothing at that path; the platform raises an IoError here)"
   }
   "writeFile" should "replace what the file held before" in mocked {
      withFile(path("/tmp/out"), "old")
      writeFile("new", path("/tmp/out"))

      readFile(path("/tmp/out")) shouldBe "new"
   }
   "fileContentAt" should "answer what the code under test wrote, without recording a call" in mocked {
      writeFile("written", path("/tmp/out"))

      (fileContentAt(path("/tmp/out")) orElse "<missing>") shouldBe "written"
      calls shouldBe "writeFile /tmp/out"
   }
   "fileContentAt" should "answer what the test arranged" in mocked {
      withFile(path("/etc/hosts"), "127.0.0.1 localhost")

      (fileContentAt(path("/etc/hosts")) orElse "<missing>") shouldBe "127.0.0.1 localhost"
   }
   "fileContentAt" should "answer nothing where there is no file, keeping an empty one distinct" in mocked {
      withFile(path("/tmp/empty"), "")
      withDirectory(path("/tmp/dir"))

      (fileContentAt(path("/tmp/empty")) orElse "<missing>") shouldBe ""
      (fileContentAt(path("/tmp/nowhere")) orElse "<missing>") shouldBe "<missing>"
      (fileContentAt(path("/tmp/dir")) orElse "<missing>") shouldBe "<missing>"
   }
   "existsAt" should "see files, directories and the directories files imply, without recording a call" in mocked {
      withFile(path("/tmp/dir/nested/one"), "1")
      createDirectories(path("/tmp/made"))

      existsAt(path("/tmp/dir/nested/one")).shouldBeTrue
      existsAt(path("/tmp/dir")).shouldBeTrue
      existsAt(path("/tmp/made")).shouldBeTrue
      existsAt(path("/tmp/elsewhere")).shouldBeFalse
      calls shouldBe "createDirectories /tmp/made"
   }
   "filesUnder" should "answer every file underneath, however deep, and no directory, without recording a call" in mocked {
      withFile(path("/tmp/dir/one"), "1")
      withFile(path("/tmp/dir/nested/three"), "3")
      withDirectory(path("/tmp/dir/empty"))
      withFile(path("/tmp/beside"), "b")

      filesUnder(path("/tmp/dir")).map(show).sorted.joined(",") shouldBe "/tmp/dir/nested/three,/tmp/dir/one"
      nothingWasCalled
   }
   "the filesystem double" should "record every call it is asked, in order" in mocked {
      exists(path("/a"))
      writeFile("x", path("/b"))
      delete(path("/b"))

      calls shouldBe "exists /a; writeFile /b; delete /b"
   }
}

/**
 * Cases the double refuses, run as a suite of their own so that the failures can be read: a refusal fails the
 * case it happens in, where `raising` around the call cannot see it, because the double's failure is bound where
 * `mocked` binds the double.
 */
private def refusals: Test = {
   "foldCodePoints" should "be refused" in mocked {
      withFile(path("/tmp/three"), "abc")

      foldCodePoints(7, acc -> _ -> acc + 1, path("/tmp/three"))
      success
   }
   "delete" should "be refused for a directory that is not empty" in mocked {
      withFile(path("/tmp/dir/one"), "1")

      delete(path("/tmp/dir"))
   }
   "delete" should "be refused for a path nothing is at" in mocked {
      delete(path("/tmp/nowhere"))
   }
}

/**
 * Each refused case's failure, rendered, or `none` for a case that passed.
 */
private def refusalFailures: List[String] = runWriterToLog(refusals).map(failureOf)

private def failureOf(result: TestResult): String = result.outcome match {
   case Passed              -> "none"
   case FailedWith(failure) -> show(failure)
}
