import eliot.collection.List
import eliot.file.Path
import eliot.system.Process
import eliot.test.Assertion
import eliot.test.Test
import eliot.test.Mock

/**
 * The verification words — what a test asks about the calls rather than about the answer — each tested both
 * ways: passing when it should, and failing (checked with `raising`) when it should.
 */
def testCases: Test = {
   "calls" should "answer every call in order, joined" in mocked {
      printLine("one")
      printLine("two")

      calls shouldBe "printLine one; printLine two"
   }
   "calls" should "answer empty before anything is asked" in mocked {
      calls shouldBe ""
   }
   "callsMatching" should "answer only the calls containing the fragment" in mocked {
      printLine("keep this")
      log("drop this")
      printLine("keep that")

      callsMatching("printLine") shouldBe "printLine keep this; printLine keep that"
   }
   "lastCall" should "answer the most recent call" in mocked {
      printLine("first")
      printLine("last")

      lastCall shouldBe "printLine last"
   }
   "lastCall" should "answer nothing before anything is asked" in mocked {
      lastCall shouldBe "<none>"
   }
   "callCount" should "count the calls containing the fragment" in mocked {
      printLine("a")
      printLine("b")
      log("c")

      callCount("printLine") shouldBe 2
      callCount("log") shouldBe 1
      callCount("readLine") shouldBe 0
   }
   "wasCalled" should "pass when a call matched the fragment" in mocked {
      printLine("hello there")

      wasCalled("printLine hello")
   }
   "wasCalled" should "match what was called exactly, never one of its arguments" in mocked {
      printLine("delete this")

      wasNeverCalled("delete")
      wasNeverCalled("print")
      wasCalled("printLine delete")
   }
   "wasCalled" should "match what was called alone, whatever its arguments" in mocked {
      printLine("anything at all")

      wasCalled("printLine")
   }
   "wasCalled" should "match whole words only" in mocked {
      printLine("catalog")

      wasNeverCalled("log")
      wasNeverCalled("printLine cat")
      wasCalled("printLine catalog")
   }
   "wasCalled" should "match words next to each other and in order" in mocked {
      printLine("one two three")

      wasCalled("printLine two three")
      wasNeverCalled("printLine one three")
      wasNeverCalled("printLine three two")
   }
   "wasCalled" should "fail, naming the calls, when nothing matched" in mocked {
      printLine("hello")

      raising("expected a call matching 'printLine goodbye'", wasCalled("printLine goodbye"))
   }
   "wasNeverCalled" should "pass when nothing matched" in mocked {
      printLine("hello")

      wasNeverCalled("printLine goodbye")
   }
   "wasNeverCalled" should "fail, showing what was found, when something matched" in mocked {
      printLine("hello")

      raising("expected no call matching 'printLine hello'", wasNeverCalled("printLine hello"))
   }
   "wasCalledOnce" should "pass for exactly one matching call" in mocked {
      printLine("only")

      wasCalledOnce("printLine only")
   }
   "wasCalledOnce" should "fail for a second matching call" in mocked {
      printLine("twice")
      printLine("twice")

      raising("exactly 1 call matching 'printLine twice'", wasCalledOnce("printLine twice"))
   }
   "wasCalledTimes" should "pass for exactly that many matching calls" in mocked {
      printLine("a")
      printLine("a")
      printLine("a")

      wasCalledTimes(3, "printLine a")
   }
   "wasCalledTimes" should "fail when the count differs" in mocked {
      printLine("a")

      raising("exactly 2 calls", wasCalledTimes(2, "printLine a"))
   }
   "wasCalledAtLeast" should "pass at the boundary and above it" in mocked {
      printLine("a")
      printLine("a")

      wasCalledAtLeast(2, "printLine a")
      wasCalledAtLeast(1, "printLine a")
   }
   "wasCalledAtLeast" should "fail below the boundary" in mocked {
      printLine("a")

      raising("at least 2 calls", wasCalledAtLeast(2, "printLine a"))
   }
   "wasCalledAtMost" should "pass at the boundary and below it" in mocked {
      printLine("a")

      wasCalledAtMost(1, "printLine a")
      wasCalledAtMost(5, "printLine a")
   }
   "wasCalledAtMost" should "fail above the boundary" in mocked {
      printLine("a")
      printLine("a")

      raising("at most 1 call matching", wasCalledAtMost(1, "printLine a"))
   }
   "wereCalledInOrder" should "pass when the calls happened in that order" in mocked {
      printLine("first")
      log("in between")
      printLine("second")

      wereCalledInOrder(append(singleton("printLine first"), "printLine second"))
   }
   "wereCalledInOrder" should "fail when they happened in the other order" in mocked {
      printLine("second")
      printLine("first")

      raising("expected calls in order", wereCalledInOrder(append(singleton("printLine first"), "printLine second")))
   }
   "nothingWasCalled" should "pass when no double was asked anything" in mocked {
      nothingWasCalled
   }
   "nothingWasCalled" should "fail as soon as something was" in mocked {
      printLine("something")

      raising("expected no calls", nothingWasCalled)
   }
   "onlyTheseWereCalled" should "pass when every call was expected" in mocked {
      printLine("expected one")
      log("expected two")

      onlyTheseWereCalled(append(singleton("printLine"), "log"))
   }
   "onlyTheseWereCalled" should "fail, naming the surprise, when something else was called too" in mocked {
      printLine("expected")
      log("a surprise")

      raising("unexpected calls: log a surprise", onlyTheseWereCalled(singleton("printLine")))
   }
   "forgetCalls" should "clear the calls while keeping the arrangements" in mocked {
      whenSpawning("git ls-remote", succeeding("v1.0"))
      run(command("git").withArgument("ls-remote"), path("."))

      forgetCalls

      nothingWasCalled
      run(command("git").withArgument("ls-remote"), path(".")).standardOutput shouldBe "v1.0"
   }
   "a blank fragment" should "fail every verification given one, rather than match everything or nothing" in mocked {
      printLine("something")

      raising("names nothing that was called", wasCalled(""))
      raising("names nothing that was called", wasNeverCalled("  "))
      raising("names nothing that was called", wasCalledTimes(1, ""))
      raising("names nothing that was called", wereCalledInOrder(append(singleton("printLine"), "")))
      raising("names nothing that was called", onlyTheseWereCalled(singleton("")))
   }
   "a fragment naming only a directory" should "count as blank" in mocked {
      raising("names nothing that was called", wasNeverCalled("/work$"))
   }
   "a fragment naming a directory" should "match only a process spawned there, where one naming none matches any call" in mocked {
      printLine("x")
      run(command("printLine").withArgument("x"), path("/work"))

      wasCalledTimes(2, "printLine x")
      wasCalledOnce("/work$ printLine x")
      wasNeverCalled("/elsewhere$ printLine")
   }
   "recordedCalls" should "answer each call with its operation and arguments apart" in mocked {
      recordCall("tag", singleton("a b"))
      recordCall("tag", append(singleton("a"), "b"))

      recordedCalls.map(call -> show(call.callArguments.size)).joined(" ") shouldBe "1 2"
      calls shouldBe "tag a b; tag a b"
   }
   "recordedCalls" should "answer a spawned process with its directory and command line" in mocked {
      run(command("git").withArgument("fetch"), path("/work"))

      recordedCalls.map(call -> call.callee).joined(" ") shouldBe "git"
      recordedCalls.map(call -> call.callArguments.joined(" ")).joined("; ") shouldBe "fetch"
      recordedCalls.map(call -> call.callDirectory orElse "<none>").joined(" ") shouldBe "/work"
   }
   "raising" should "pass when the body raised what was expected" in mocked {
      raising("boom", failedWith("boom"))
   }
   "raising" should "match a report by containment, not by the whole text" in mocked {
      raising("middle", failedWith("start middle end"))
   }
   "raising" should "fail when the body raised something else" in mocked {
      raising("but got 'Failed(other)'", raising("expected", failedWith("other")))
   }
   "raising" should "fail when the body raised nothing at all" in mocked {
      raising("but nothing was raised", raising[AssertionError]("expected", printLine("no raise here")))
   }
   "raising" should "keep the calls the body made before it raised" in mocked {
      raising("boom", printedThenFailed)

      wasCalled("printLine before the raise")
   }
   "a mocked body" should "stop at the first raise, so nothing after it runs" in mocked {
      raising("boom", printedThenFailed)

      wasNeverCalled("printLine after the raise")
   }
   "recordCall" should "journal a call that reads like the framework's own" in mocked {
      recordCall("cloneMirror", append(singleton("https://github.com/x/foo"), "target/cache"))

      calls shouldBe "cloneMirror https://github.com/x/foo target/cache"
   }
   "recordCall" should "journal an operation with no arguments as the operation alone" in mocked {
      recordCall("fetch", empty)

      calls shouldBe "fetch"
   }
   "recordCall" should "let a project's double be verified in order among the framework's" in mocked {
      greetVisitor("Ann") with recordingDoorbell

      calls shouldBe "printLine someone is at the door; ring Ann; printLine welcome, Ann"
      wasCalledOnce("ring Ann")
      wereCalledInOrder(append(singleton("printLine someone"), "ring"))
   }
   "an arrangement" should "be shareable as an ordinary definition, which is this framework's @Before" in mocked {
      twoLinesReady

      run(command("git").withArgument("ls-remote"), path(".")).standardOutput shouldBe "v1.0\nv1.1"
   }
}

/**
 * A project's own effect, for testing `recordCall`: nothing in the framework has a double for it.
 */
effect Doorbell {
   def ring(visitor: String): Unit
}

/**
 * The project's double of `Doorbell`: it records each ring in the framework's journal.
 */
implement recordingDoorbell: Doorbell {
   def ring(visitor: String): {Mocking} Unit = recordCall("ring", singleton(visitor))
}

/**
 * Code under test performing the project's effect between two of the framework's.
 */
def greetVisitor(visitor: String): {Console, Doorbell} Unit = {
   printLine("someone is at the door")
   ring(visitor)
   printLine("welcome, " ++ visitor)
}

/**
 * A body that raises a plain reported failure, for testing `raising` itself.
 */
private def failedWith(report: String): {Throw[AssertionError]} Unit = raise(Failed(report))

/**
 * A body that does something *and then* raises, so the calls it made before raising can be verified.
 */
private def printedThenFailed: {Console, Throw[AssertionError]} Unit = {
   printLine("before the raise")

   raise(Failed("boom"))

   printLine("after the raise")
}

/**
 * A shared arrangement: an ordinary `{Mocking}` definition, called at the top of a body.
 */
private def twoLinesReady: {Mocking} Unit = whenSpawning("git ls-remote", succeeding("v1.0\nv1.1"))
