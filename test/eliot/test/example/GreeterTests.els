import eliot.collection.List
import eliot.test.Assertion
import eliot.test.Test
import eliot.test.example.Greeter
import eliot.test.example.FakeConsole

/**
 * **One suite, four kinds of test.** Pure unit tests, run-then-assert tests over effectful code, tests performing real
 * effects inline, and direct-style tests interleaving *faked* effects with assertions — registered side by side in one
 * `testCases`, reported by the one runner, counted in the one summary.
 *
 * They mix because `in` supplies only the assertion effect. What a body may otherwise do is decided by this suite's
 * return type — `{Console} Test`, so a case may print for real — and by the doubles an author's own word binds on its
 * slot. Nothing here is a fixture, and nothing production-side knows a test exists.
 */
def testCases: {Console} Test = {
   // --- 1. plain unit tests: nothing to run, nothing to bind -------------------------------------------------------
   "greeting" should "address the name it was given" in {
      greeting("Bob") shouldBe "Hello, Bob!"
   }
   "greeting" should "not be the bare name" in {
      greeting("Bob") shouldNotBe "Bob"
   }

   // --- 2. run-then-assert over effectful code --------------------------------------------------------------------
   // `transcriptOf`'s slot carries `with fakeConsole`, so the caller binds nothing and what reaches the assertion is
   // a plain `String`. Nothing has to be instantiated, so the run is written right here.
   "greet" should "greet whoever the console offers" in {
      transcriptOf(singleton("Bob"), greet) shouldBe "Hello, Bob!\n"
   }
   "greet" should "fall back to a stranger on no input" in {
      transcriptOf(empty, greet) shouldBe "Hello, stranger!\n"
   }

   // --- 3. real effects, written inline ----------------------------------------------------------------------------
   // The suite declares `{Console} Test`, so a body may perform it — bound by whoever ran the runner. Nothing here
   // names an implementation, and the body needs no definition of its own.
   "real effects" should "be available to a body whose suite declares them" in {
      printLine(" | (this line was printed by a test performing a real Console effect)")
      success
   }

   // --- 3b. `expect` over a body that performs ----------------------------------------------------------------------
   // `expect`'s body slot supplies `Throw[E]` and nothing else, so a body that prints *and* raises is checkable.
   "expect" should "wrap a body that performs a real effect while it raises" in {
      expect(Failed("after printing"), {
         printLine(" | (printed by a body wrapped in `expect`)")
         fail("after printing")
      })
   }

   // --- 3c. `message` over a body that performs ----------------------------------------------------------------------
   // `message` discharges the very effect it declares — the nearest enclosing frame is its own — so it wraps a body
   // however that body was written, printing included.
   "message" should "rewrite a failure raised by a body that performs" in {
      expect(Failed("printed, then failed"), {
         printLine(" | (printed by a body wrapped in `message`)")
         fail("boom")
      } message "printed, then failed")
   }

   // --- 4. direct-style over the doubles -----------------------------------------------------------------------------
   // The body performs the faked console and asserts *between* its steps. Same suite, same runner, same summary.
   "greet" should "read its name from the console it is given" in onConsoleReading(singleton("Ann"), {
      greet
      transcript shouldBe "Hello, Ann!\n"
   })

   "farewell" should "say goodbye, then invite a return" in onConsole {
      printLine("--")
      transcript shouldBe "--\n"
      farewell("Bob")
      transcript shouldBe "--\nGoodbye, Bob.\nCome back soon!\n"
   }
}
