import eliot.collection.List
import eliot.test.Assertion

/**
 * **Test doubles for the console**, and the two words that run a test body against them — the worked example of what
 * "a named implementation is the injection point" costs a test author.
 *
 * There is nothing to instantiate here: a double is **one declaration**, never searched for and never
 * checked against the platform's default, so it may freely overlap one. What the doubles need at runtime they ask an
 * *effect* for — `State[Session]`, threading the input still to be read and everything written so far — and that entry
 * is charged where the doubles are bound, which is the slot of `onConsole` below, and discharged there.
 *
 * A double **cannot cheat**: a user module declares no natives and the platform's are private to its layer, so an
 * implementation reaches the world only through the effects its own clauses declare — here one `State`, discharged
 * before the test ever sees it.
 */

/**
 * What the fake console holds: the lines `readLine` has yet to hand out, and everything `printLine` has written.
 */
data Session(pending: List[String], transcribed: String)

/**
 * Reading back what the body has written so far — an effect of the test's own, with no counterpart in production.
 * This is what a mid-run assertion asserts *on*.
 */
effect Transcript {
   def transcript: String
}

/**
 * The fake interpretation of the standard `Console` effect: a **named** implementation, so it is never a default and
 * the platform's real console is left exactly where it was. Its clauses declare `{State[Session]}` — what this double
 * needs to do its job — and that is the only way it reaches anything outside itself.
 */
implement fakeConsole: Console {
   def printLine(s: String): {State[Session]} Unit = updateState(session -> appended(session, s))

   def readLine: {State[Session]} Option[String] = takeLine(state)
}

/**
 * The fake's own effect, over the same `Session`.
 */
implement fakeTranscript: Transcript {
   def transcript: {State[Session]} String = transcribed(state)
}

/**
 * The **discharge word** for a body that uses the console and asserts as it goes:
 * `"…" should "…" in onConsole { … }`.
 *
 * The seam is the slot's *type*: `with fakeConsole with fakeTranscript` binds the calls the caller writes there, and
 * the caller writes nothing. `Console` and `Transcript` are entries this definition's own row does not name, so the
 * slot supplies them; the `State[Session]` the doubles perform is supplied in turn by `runStateToValue`, and what is
 * left over — the case's assertions — rides outward into `{Throw[AssertionError]}`, exactly where `in` will discharge
 * it.
 */
def onConsole(body: {Console, Transcript} Unit with fakeConsole with fakeTranscript): {Throw[AssertionError]} Unit =
   runStateToValue(Session(empty, ""), body)

/**
 * `onConsole` for a body that reads: `input` is what `readLine` will hand out, in order.
 */
def onConsoleReading(
      input: List[String],
      body: {Console, Transcript} Unit with fakeConsole with fakeTranscript): {Throw[AssertionError]} Unit =
   runStateToValue(Session(input, ""), body)

/**
 * What a `{Console}` program wrote, with no console involved — for a **run-then-assert** test. Nothing has to be
 * instantiated, so this may be written anywhere, an effectful body included; it stays a separate word only because an
 * assertion about a finished transcript reads better than one threaded through the run.
 */
def transcriptOf(input: List[String], program: {Console} Unit with fakeConsole): String =
   transcribed(runStateToFinalState(Session(input, ""), program))

/**
 * `private` because it is `fakeConsole`'s way of advancing the session, not an operation of its own: hand out the next
 * pending line, keeping everything written.
 */
private def takeLine(session: Session): {State[Session]} Option[String] = {
   putState(Session(session.pending.tail, session.transcribed))

   session.pending.head
}

/**
 * `private` because it is `printLine`'s half of the same: everything written so far, with `line` and its separator
 * appended.
 */
private def appended(session: Session, line: String): Session =
   Session(session.pending, session.transcribed ++ line ++ "\n")
